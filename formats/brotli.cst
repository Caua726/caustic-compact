// =======================================================
// caustic-compact/formats/brotli.cst
// Brotli decompression (RFC 7932). Port of the reference Java decoder
// (org.brotli.dec), simplified for one-shot decode: output accumulates in
// a growable Bytes buffer that doubles as the unbounded sliding window, so
// the ring-buffer / streaming machinery collapses away.
// Two-level Huffman tables, block-type switching (literal/command/distance),
// context maps with inverse-MTF, the insert-and-copy command alphabet, the
// distance ring + postfix/direct coding, and the static dictionary with
// its 121 word transforms.
//   brotli_decompress(src, src_len, out) -> bytes written, or -err.
// =======================================================

use "../core/errno.cst" as errno;
use "../core/bytes.cst" as bytes;
use "std/mem.cst" only bins, core as mem;
use "brotli_dict.cst" as bd;
use "brotli_transforms.cst" as bt;
use "../core/shared.cst" as shared;
use "../core/bitwriter.cst" as biw;

// Everything one decode has, so several can be under way.
struct Br {
    mem as shared.Scratch;
    rings as [16]i64;
    src as *u8;
    slen as i64;
    bitp as i64;
    sorted as *i64;
    clen as *i64;
    distRbIdx as i64;
    mbLen as i64;
    inputEnd as i64;
    isUncompressed as i64;
    isMetadata as i64;
    numLitTypes as i64;
    numCmdTypes as i64;
    numDistTypes as i64;
    litBlockLen as i64;
    cmdBlockLen as i64;
    distBlockLen as i64;
    contextMap as *i64;
    distContextMap as *i64;
    contextModes as *i64;
    contextMapSlice as i64;
    distContextMapSlice as i64;
    ctxLook1 as i64;
    ctxLook2 as i64;
    litTreeIdx as i64;
    cmdTreeIdx as i64;
    trivialLit as i64;
    litGroup as *i64;
    cmdGroup as *i64;
    distGroup as *i64;
    blockTrees as *i64;
    npostfix as i64;
    ndirect as i64;
    largeWindow as i64;
    distExtra as *i64;
    distOff as *i64;
    maxBackward as i64;
    maxDist as i64;
}

// ---------------------------------------------------------------- bit reader

fn _peek(S as *Br, n as i64) as i64 {
    let is i64 as bytepos = S.bitp >> 3;
    if (bytepos + 8 <= S.slen) {                          // fast path: one 64-bit LE load
        let is i64 as x = cast(*i64, cast(i64, S.src) + bytepos)[0];
        return cast(i64, cast(u64, x) >> cast(u64, S.bitp & 7)) & ((1 << n) - 1);
    }
    let is i64 as v with mut = 0;
    let is i64 as shift with mut = 0;
    let is i64 as left with mut = n;
    let is i64 as bp with mut = S.bitp;
    while (left > 0) {
        let is i64 as byteIdx = bp >> 3;
        let is i64 as bitOff = bp & 7;
        let is i64 as byte with mut = 0;
        if (byteIdx < S.slen) { byte = cast(i64, S.src[byteIdx]); }
        let is i64 as take with mut = 8 - bitOff;
        if (take > left) { take = left; }
        v = v | (((byte >> bitOff) & ((1 << take) - 1)) << shift);
        shift = shift + take;
        bp = bp + take;
        left = left - take;
    }
    return v;
}

fn _take(S as *Br, n as i64) as i64 {
    let is i64 as v = _peek(S, n);
    S.bitp = S.bitp + n;
    return v;
}

fn _balign(S as *Br) as void {
    S.bitp = ((S.bitp + 7) >> 3) << 3;
}

// ---------------------------------------------------------------- constants
let is *i64 as CMD with mut;       // 704*4 flat command lookup
let is *i64 as _cmdLut with mut;   // [ne*1024 + icode*32 + ccode] -> command symbol
let is *i64 as BLOFF with mut;     // block length offsets [26]
let is *i64 as BLNB with mut;      // block length nbits [26]
let is *i64 as INSNB with mut;     // insert length nbits [24]
let is *i64 as CPYNB with mut;     // copy length nbits [24]
let is *i64 as DSCIO with mut;     // distance short code index offset [16]
let is *i64 as DSCVO with mut;     // distance short code value offset [16]
let is *i64 as FIXED with mut;     // code-length-code fixed table [16]
let is *i64 as CLCO with mut;      // code length code order [18]
let is *i64 as DSB with mut;       // dictionary size bits [32]
let is *i64 as DOFF with mut;      // dictionary offsets [32]
let is *i64 as MHTS with mut;      // max huffman table size [23]
let is *i64 as CTX with mut;       // context lookup [2048]
let is u32 as _tab_ready with mut = 0;

let is *u8 as _UM with imut = "\x20\x20\x20\x20\x20\x20\x20\x20\x20\x21\x21\x20\x20\x21\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x20\x22\x23\x24\x23\x23\x25\x23\x24\x26\x27\x23\x23\x28\x23\x29\x23\x2b\x2b\x2b\x2b\x2b\x2b\x2b\x2b\x2b\x2b\x28\x28\x26\x2a\x27\x23\x23\x2c\x2d\x2d\x2d\x2c\x2d\x2d\x2d\x2c\x2d\x2d\x2d\x2d\x2d\x2c\x2d\x2d\x2d\x2d\x2d\x2c\x2d\x2d\x2d\x2d\x2d\x26\x23\x27\x23\x23\x23\x2e\x2f\x2f\x2f\x2e\x2f\x2f\x2f\x2e\x2f\x2f\x2f\x2f\x2f\x2e\x2f\x2f\x2f\x2f\x2f\x2e\x2f\x2f\x2f\x2f\x2f\x26\x23\x27\x23\x20";
let is *u8 as _UR with imut = "\x41\x2f\x2a\x20\x20\x27\x3a\x20\x20\x26\x20\x3a\x20\x24\x20\x20\x81\x20\x40";

fn _ia(n as i64) as *i64 { return cast(*i64, mem.core.mmap_anon(n * 8)); }

fn _ctx_init() as void {
    let is i64 as i with mut = 0;
    while (i < 256) {
        CTX[i] = i & 0x3F;
        CTX[512 + i] = i >> 2;
        CTX[1792 + i] = 2 + (i >> 6);
        i = i + 1;
    }
    i = 0;
    while (i < 128) { CTX[1024 + i] = 4 * (cast(i64, _UM[i]) - 32); i = i + 1; }
    i = 0;
    while (i < 64) { CTX[1152 + i] = i & 1; CTX[1216 + i] = 2 + (i & 1); i = i + 1; }
    let is i64 as off with mut = 1280;
    let is i64 as k with mut = 0;
    while (k < 19) {
        let is i64 as value = k & 3;
        let is i64 as rep = cast(i64, _UR[k]) - 32;
        let is i64 as j with mut = 0;
        while (j < rep) { CTX[off] = value; off = off + 1; j = j + 1; }
        k = k + 1;
    }
    i = 0;
    while (i < 16) { CTX[1792 + i] = 1; CTX[2032 + i] = 6; i = i + 1; }
    CTX[1792] = 0;
    CTX[2047] = 7;
    i = 0;
    while (i < 256) { CTX[1536 + i] = CTX[1792 + i] << 3; i = i + 1; }
}

fn _cmd_init() as void {
    let is [24]i64 as insOff;
    let is [24]i64 as cpyOff;
    cpyOff[0] = 2;
    insOff[0] = 0;
    let is i64 as i with mut = 0;
    while (i < 23) {
        insOff[i + 1] = insOff[i] + (1 << INSNB[i]);
        cpyOff[i + 1] = cpyOff[i] + (1 << CPYNB[i]);
        i = i + 1;
    }
    let is i64 as cmdCode with mut = 0;
    while (cmdCode < 704) {
        let is i64 as rangeIdx with mut = cmdCode >> 6;
        let is i64 as distCtxOff with mut = 0 - 4;
        if (rangeIdx >= 2) { rangeIdx = rangeIdx - 2; distCtxOff = 0; }
        let is i64 as insertCode = (((0x29850 >> (rangeIdx * 2)) & 0x3) << 3) | ((cmdCode >> 3) & 7);
        let is i64 as copyCode = (((0x26244 >> (rangeIdx * 2)) & 0x3) << 3) | (cmdCode & 7);
        let is i64 as cpoff = cpyOff[copyCode];
        let is i64 as m with mut = cpoff;
        if (m > 5) { m = 5; }
        let is i64 as distContext = distCtxOff + m - 2;
        let is i64 as idx = cmdCode * 4;
        CMD[idx] = INSNB[insertCode] | (CPYNB[copyCode] << 8);
        CMD[idx + 1] = insOff[insertCode];
        CMD[idx + 2] = cpoff;
        CMD[idx + 3] = distContext;
        cmdCode = cmdCode + 1;
    }
    // reverse lookup (icode, ccode, needExplicit) -> command symbol (first match)
    _cmdLut = _ia(2048);
    let is i64 as li with mut = 0;
    while (li < 2048) { _cmdLut[li] = 0 - 1; li = li + 1; }
    let is i64 as cc2 with mut = 0;
    while (cc2 < 704) {
        let is i64 as ri with mut = cc2 >> 6;
        if (ri >= 2) { ri = ri - 2; }
        let is i64 as ic = (((0x29850 >> (ri * 2)) & 0x3) << 3) | ((cc2 >> 3) & 7);
        let is i64 as cp = (((0x26244 >> (ri * 2)) & 0x3) << 3) | (cc2 & 7);
        if (_cmdLut[ic * 32 + cp] < 0) { _cmdLut[ic * 32 + cp] = cc2; }
        if (CMD[cc2 * 4 + 3] >= 0) { if (_cmdLut[1024 + ic * 32 + cp] < 0) { _cmdLut[1024 + ic * 32 + cp] = cc2; } }
        cc2 = cc2 + 1;
    }
}

fn _tabs() as void {
    if (shared.once_enter(&_tab_ready) == 0) { return; }
    bt._trans_init();
    bd.dict();
    CMD = _ia(704 * 4);
    BLOFF = _ia(26); BLNB = _ia(26); INSNB = _ia(24); CPYNB = _ia(24);
    DSCIO = _ia(16); DSCVO = _ia(16); FIXED = _ia(16); CLCO = _ia(18);
    DSB = _ia(32); DOFF = _ia(32); MHTS = _ia(23); CTX = _ia(2048);

    BLOFF[0]=1; BLOFF[1]=5; BLOFF[2]=9; BLOFF[3]=13; BLOFF[4]=17; BLOFF[5]=25;
    BLOFF[6]=33; BLOFF[7]=41; BLOFF[8]=49; BLOFF[9]=65; BLOFF[10]=81; BLOFF[11]=97;
    BLOFF[12]=113; BLOFF[13]=145; BLOFF[14]=177; BLOFF[15]=209; BLOFF[16]=241;
    BLOFF[17]=305; BLOFF[18]=369; BLOFF[19]=497; BLOFF[20]=753; BLOFF[21]=1265;
    BLOFF[22]=2289; BLOFF[23]=4337; BLOFF[24]=8433; BLOFF[25]=16625;
    BLNB[0]=2; BLNB[1]=2; BLNB[2]=2; BLNB[3]=2; BLNB[4]=3; BLNB[5]=3; BLNB[6]=3;
    BLNB[7]=3; BLNB[8]=4; BLNB[9]=4; BLNB[10]=4; BLNB[11]=4; BLNB[12]=5; BLNB[13]=5;
    BLNB[14]=5; BLNB[15]=5; BLNB[16]=6; BLNB[17]=6; BLNB[18]=7; BLNB[19]=8; BLNB[20]=9;
    BLNB[21]=10; BLNB[22]=11; BLNB[23]=12; BLNB[24]=13; BLNB[25]=24;

    INSNB[0]=0; INSNB[1]=0; INSNB[2]=0; INSNB[3]=0; INSNB[4]=0; INSNB[5]=0;
    INSNB[6]=1; INSNB[7]=1; INSNB[8]=2; INSNB[9]=2; INSNB[10]=3; INSNB[11]=3;
    INSNB[12]=4; INSNB[13]=4; INSNB[14]=5; INSNB[15]=5; INSNB[16]=6; INSNB[17]=7;
    INSNB[18]=8; INSNB[19]=9; INSNB[20]=10; INSNB[21]=12; INSNB[22]=14; INSNB[23]=24;
    CPYNB[0]=0; CPYNB[1]=0; CPYNB[2]=0; CPYNB[3]=0; CPYNB[4]=0; CPYNB[5]=0;
    CPYNB[6]=0; CPYNB[7]=0; CPYNB[8]=1; CPYNB[9]=1; CPYNB[10]=2; CPYNB[11]=2;
    CPYNB[12]=3; CPYNB[13]=3; CPYNB[14]=4; CPYNB[15]=4; CPYNB[16]=5; CPYNB[17]=5;
    CPYNB[18]=6; CPYNB[19]=7; CPYNB[20]=8; CPYNB[21]=9; CPYNB[22]=10; CPYNB[23]=24;

    DSCIO[0]=0; DSCIO[1]=3; DSCIO[2]=2; DSCIO[3]=1; DSCIO[4]=0; DSCIO[5]=0; DSCIO[6]=0;
    DSCIO[7]=0; DSCIO[8]=0; DSCIO[9]=0; DSCIO[10]=3; DSCIO[11]=3; DSCIO[12]=3;
    DSCIO[13]=3; DSCIO[14]=3; DSCIO[15]=3;
    DSCVO[0]=0; DSCVO[1]=0; DSCVO[2]=0; DSCVO[3]=0; DSCVO[4]=0-1; DSCVO[5]=1;
    DSCVO[6]=0-2; DSCVO[7]=2; DSCVO[8]=0-3; DSCVO[9]=3; DSCVO[10]=0-1; DSCVO[11]=1;
    DSCVO[12]=0-2; DSCVO[13]=2; DSCVO[14]=0-3; DSCVO[15]=3;

    FIXED[0]=0x020000; FIXED[1]=0x020004; FIXED[2]=0x020003; FIXED[3]=0x030002;
    FIXED[4]=0x020000; FIXED[5]=0x020004; FIXED[6]=0x020003; FIXED[7]=0x040001;
    FIXED[8]=0x020000; FIXED[9]=0x020004; FIXED[10]=0x020003; FIXED[11]=0x030002;
    FIXED[12]=0x020000; FIXED[13]=0x020004; FIXED[14]=0x020003; FIXED[15]=0x040005;
    CLCO[0]=1; CLCO[1]=2; CLCO[2]=3; CLCO[3]=4; CLCO[4]=0; CLCO[5]=5; CLCO[6]=17;
    CLCO[7]=6; CLCO[8]=16; CLCO[9]=7; CLCO[10]=8; CLCO[11]=9; CLCO[12]=10; CLCO[13]=11;
    CLCO[14]=12; CLCO[15]=13; CLCO[16]=14; CLCO[17]=15;

    let is i64 as i with mut = 0;
    while (i < 32) { DSB[i] = 0; i = i + 1; }
    DSB[4]=10; DSB[5]=10; DSB[6]=11; DSB[7]=11; DSB[8]=10; DSB[9]=10; DSB[10]=10;
    DSB[11]=10; DSB[12]=10; DSB[13]=9; DSB[14]=9; DSB[15]=8; DSB[16]=7; DSB[17]=7;
    DSB[18]=8; DSB[19]=7; DSB[20]=7; DSB[21]=6; DSB[22]=6; DSB[23]=5; DSB[24]=5;
    let is i64 as pos with mut = 0;
    i = 0;
    while (i < 32) {
        DOFF[i] = pos;
        if (DSB[i] != 0) { pos = pos + (i << DSB[i]); }
        i = i + 1;
    }

    MHTS[0]=256; MHTS[1]=402; MHTS[2]=436; MHTS[3]=468; MHTS[4]=500; MHTS[5]=534;
    MHTS[6]=566; MHTS[7]=598; MHTS[8]=630; MHTS[9]=662; MHTS[10]=694; MHTS[11]=726;
    MHTS[12]=758; MHTS[13]=790; MHTS[14]=822; MHTS[15]=854; MHTS[16]=886; MHTS[17]=920;
    MHTS[18]=952; MHTS[19]=984; MHTS[20]=1016; MHTS[21]=1048; MHTS[22]=1080;

    _cmd_init();
    _ctx_init();
    shared.once_leave(&_tab_ready, 1);
}

// ---------------------------------------------------------------- Huffman

fn _nextKey(key as i64, len as i64) as i64 {
    let is i64 as step with mut = 1 << (len - 1);
    while ((key & step) != 0) { step = step >> 1; }
    return (key & (step - 1)) + step;
}

fn _nextTableBitSize(count as *i64, len as i64, rootBits as i64) as i64 {
    let is i64 as bits with mut = len;
    let is i64 as left with mut = 1 << (bits - rootBits);
    while (bits < 15) {
        left = left - count[bits];
        if (left <= 0) { break; }
        bits = bits + 1;
        left = left << 1;
    }
    return bits - rootBits;
}

// Build a two-level Huffman table into group (group[tableIdx] = base offset).
// Returns number of slots used.
fn _buildHuff(S as *Br, group as *i64, tableIdx as i64, rootBits as i64, codeLengths as *i64, size as i64) as i64 {
    let is i64 as tableOffset = group[tableIdx];
    let is [16]i64 as count;
    let is [16]i64 as offset;
    let is i64 as i with mut = 0;
    while (i < 16) { count[i] = 0; i = i + 1; }
    i = 0;
    while (i < size) { count[codeLengths[i]] = count[codeLengths[i]] + 1; i = i + 1; }
    offset[1] = 0;
    let is i64 as len with mut = 1;
    while (len < 15) { offset[len + 1] = offset[len] + count[len]; len = len + 1; }
    i = 0;
    while (i < size) {
        if (codeLengths[i] != 0) { S.sorted[offset[codeLengths[i]]] = i; offset[codeLengths[i]] = offset[codeLengths[i]] + 1; }
        i = i + 1;
    }
    let is i64 as tableBits with mut = rootBits;
    let is i64 as tableSize with mut = 1 << tableBits;
    let is i64 as totalSize with mut = tableSize;

    if (offset[15] == 1) {
        let is i64 as k with mut = 0;
        while (k < totalSize) { group[tableOffset + k] = S.sorted[0]; k = k + 1; }
        return totalSize;
    }

    let is i64 as key with mut = 0;
    let is i64 as symbol with mut = 0;
    let is i64 as step with mut = 1;
    len = 1;
    while (len <= rootBits) {
        step = step << 1;
        while (count[len] > 0) {
            let is i64 as item = (len << 16) | S.sorted[symbol];
            symbol = symbol + 1;
            let is i64 as pos with mut = tableSize;
            while (pos > 0) { pos = pos - step; group[tableOffset + key + pos] = item; }
            key = _nextKey(key, len);
            count[len] = count[len] - 1;
        }
        len = len + 1;
    }

    let is i64 as mask = totalSize - 1;
    let is i64 as low with mut = 0 - 1;
    let is i64 as currentOffset with mut = tableOffset;
    step = 1;
    len = rootBits + 1;
    while (len <= 15) {
        step = step << 1;
        while (count[len] > 0) {
            if ((key & mask) != low) {
                currentOffset = currentOffset + tableSize;
                tableBits = _nextTableBitSize(cast(*i64, &count), len, rootBits);
                tableSize = 1 << tableBits;
                totalSize = totalSize + tableSize;
                low = key & mask;
                group[tableOffset + low] = ((tableBits + rootBits) << 16) | (currentOffset - tableOffset - low);
            }
            let is i64 as item = ((len - rootBits) << 16) | S.sorted[symbol];
            symbol = symbol + 1;
            let is i64 as base = currentOffset + (key >> rootBits);
            let is i64 as pos with mut = tableSize;
            while (pos > 0) { pos = pos - step; group[base + pos] = item; }
            key = _nextKey(key, len);
            count[len] = count[len] - 1;
        }
        len = len + 1;
    }
    return totalSize;
}

fn _readSym(S as *Br, group as *i64, tableIdx as i64) as i64 {
    let is i64 as off with mut = group[tableIdx];
    let is i64 as _bpp = S.bitp >> 3;
    let is i64 as v with mut = 0;
    if (_bpp + 8 <= S.slen) { v = cast(i64, cast(u64, cast(*i64, cast(i64, S.src) + _bpp)[0]) >> cast(u64, S.bitp & 7)) & 0xFFFF; }
    else { v = _peek(S, 16); }
    off = off + (v & 0xFF);
    let is i64 as entry = group[off];
    let is i64 as bits = entry >> 16;
    let is i64 as sym = entry & 0xFFFF;
    if (bits <= 8) { S.bitp = S.bitp + bits; return sym; }
    off = off + sym;
    off = off + ((v & ((1 << bits) - 1)) >> 8);
    let is i64 as entry2 = group[off];
    S.bitp = S.bitp + ((entry2 >> 16) + 8);
    return entry2 & 0xFFFF;
}

// ---------------------------------------------------------------- state

fn _decodeVarLenByte(S as *Br) as i64 {
    if (_take(S, 1) != 0) {
        let is i64 as n = _take(S, 3);
        if (n == 0) { return 1; }
        return _take(S, n) + (1 << n);
    }
    return 0;
}

fn _decodeWindowBits(S as *Br) as i64 {
    if (_take(S, 1) == 0) { return 16; }
    let is i64 as n with mut = _take(S, 3);
    if (n != 0) { return 17 + n; }
    n = _take(S, 3);
    if (n != 0) {
        if (n == 1) {                    // large-window: 1 reserved bit + 6-bit size
            if (_take(S, 1) != 0) { return 0 - 1; }
            let is i64 as lw = _take(S, 6);
            if (lw < 10 || lw > 30) { return 0 - 1; }
            S.largeWindow = 1;
            return lw;
        }
        return 8 + n;
    }
    return 17;
}

fn _decodeMetaBlockLength(S as *Br) as i64 {
    S.inputEnd = _take(S, 1);
    S.mbLen = 0;
    S.isUncompressed = 0;
    S.isMetadata = 0;
    if (S.inputEnd != 0) {
        if (_take(S, 1) != 0) { return 0; }
    }
    let is i64 as sizeNibbles = _take(S, 2) + 4;
    if (sizeNibbles == 7) {
        S.isMetadata = 1;
        if (_take(S, 1) != 0) { return errno.Z_BADHDR; }
        // No bytes at all is what a compressor flushing part way through a stream
        // writes: nothing to skip, and no flag after it either.
        let is i64 as sizeBytes = _take(S, 2);
        if (sizeBytes == 0) { return 0; }
        let is i64 as i with mut = 0;
        while (i < sizeBytes) {
            let is i64 as bits = _take(S, 8);
            S.mbLen = S.mbLen + (bits << (i * 8));
            i = i + 1;
        }
        S.mbLen = S.mbLen + 1;
        return 0;
    } else {
        let is i64 as i with mut = 0;
        while (i < sizeNibbles) {
            let is i64 as bits = _take(S, 4);
            S.mbLen = S.mbLen + (bits << (i * 4));
            i = i + 1;
        }
    }
    S.mbLen = S.mbLen + 1;
    if (S.inputEnd == 0) { S.isUncompressed = _take(S, 1); }
    return 0;
}

fn _moveToFront(v as *i64, index as i64) as void {
    let is i64 as value = v[index];
    let is i64 as i with mut = index;
    while (i > 0) { v[i] = v[i - 1]; i = i - 1; }
    v[0] = value;
}

fn _inverseMTF(v as *i64, vLen as i64) as void {
    let is [256]i64 as mtf;
    let is i64 as i with mut = 0;
    while (i < 256) { mtf[i] = i; i = i + 1; }
    i = 0;
    while (i < vLen) {
        let is i64 as index = v[i] & 0xFF;
        v[i] = mtf[index];
        if (index != 0) { _moveToFront(cast(*i64, &mtf), index); }
        i = i + 1;
    }
}

fn _readHuffmanCodeLengths(S as *Br, clcl as *i64, numSymbols as i64, codeLengths as *i64) as i64 {
    let is i64 as symbol with mut = 0;
    let is i64 as prevCodeLen with mut = 8;
    let is i64 as repeat with mut = 0;
    let is i64 as repeatCodeLen with mut = 0;
    let is i64 as space with mut = 32768;
    let is *i64 as table = shared.scratch_words(&S.mem, 33);
    table[32] = 0;
    _buildHuff(S, table, 32, 5, clcl, 18);

    while (symbol < numSymbols) {
        if (space <= 0) { break; }
        let is i64 as p = _peek(S, 5) & 31;
        S.bitp = S.bitp + (table[p] >> 16);
        let is i64 as codeLen = table[p] & 0xFFFF;
        if (codeLen < 16) {
            repeat = 0;
            codeLengths[symbol] = codeLen;
            symbol = symbol + 1;
            if (codeLen != 0) { prevCodeLen = codeLen; space = space - (32768 >> codeLen); }
        } else {
            let is i64 as extraBits = codeLen - 14;
            let is i64 as newLen with mut = 0;
            if (codeLen == 16) { newLen = prevCodeLen; }
            if (repeatCodeLen != newLen) { repeat = 0; repeatCodeLen = newLen; }
            let is i64 as oldRepeat = repeat;
            if (repeat > 0) { repeat = repeat - 2; repeat = repeat << extraBits; }
            repeat = repeat + _take(S, extraBits) + 3;
            let is i64 as repeatDelta = repeat - oldRepeat;
            if (symbol + repeatDelta > numSymbols) { return errno.Z_BADHUFF; }
            let is i64 as i with mut = 0;
            while (i < repeatDelta) { codeLengths[symbol] = repeatCodeLen; symbol = symbol + 1; i = i + 1; }
            if (repeatCodeLen != 0) { space = space - (repeatDelta << (15 - repeatCodeLen)); }
        }
    }
    if (space != 0) { return errno.Z_BADHUFF; }
    let is i64 as i with mut = symbol;
    while (i < numSymbols) { codeLengths[i] = 0; i = i + 1; }
    return 0;
}

fn _log2floor(x as i64) as i64 {
    let is i64 as r with mut = 0 - 1;
    let is i64 as v with mut = x;
    while (v != 0) { r = r + 1; v = v >> 1; }
    return r;
}

fn _readSimpleHuffman(S as *Br, alphaMax as i64, alphaLimit as i64, group as *i64, tableIdx as i64) as i64 {
    let is i64 as i with mut = 0;
    while (i < alphaLimit) { S.clen[i] = 0; i = i + 1; }
    let is [4]i64 as symbols;
    let is i64 as maxBits = 1 + _log2floor(alphaMax - 1);
    let is i64 as numSymbols = _take(S, 2) + 1;
    i = 0;
    while (i < numSymbols) {
        let is i64 as symbol = _take(S, maxBits);
        if (symbol >= alphaLimit) { return errno.Z_BADHUFF; }
        symbols[i] = symbol;
        i = i + 1;
    }
    let is i64 as histogramId with mut = numSymbols;
    if (numSymbols == 4) { histogramId = histogramId + _take(S, 1); }
    if (histogramId == 1) {
        S.clen[symbols[0]] = 1;
    } else if (histogramId == 2) {
        S.clen[symbols[0]] = 1; S.clen[symbols[1]] = 1;
    } else if (histogramId == 3) {
        S.clen[symbols[0]] = 1; S.clen[symbols[1]] = 2; S.clen[symbols[2]] = 2;
    } else if (histogramId == 4) {
        S.clen[symbols[0]] = 2; S.clen[symbols[1]] = 2; S.clen[symbols[2]] = 2; S.clen[symbols[3]] = 2;
    } else if (histogramId == 5) {
        S.clen[symbols[0]] = 1; S.clen[symbols[1]] = 2; S.clen[symbols[2]] = 3; S.clen[symbols[3]] = 3;
    }
    return _buildHuff(S, group, tableIdx, 8, S.clen, alphaLimit);
}

fn _readComplexHuffman(S as *Br, alphaLimit as i64, skip as i64, group as *i64, tableIdx as i64) as i64 {
    let is [18]i64 as clcl;
    let is i64 as i with mut = 0;
    while (i < 18) { clcl[i] = 0; i = i + 1; }
    let is i64 as space with mut = 32;
    let is i64 as numCodes with mut = 0;
    i = skip;
    while (i < 18) {
        let is i64 as codeLenIdx = CLCO[i];
        let is i64 as p = _peek(S, 4) & 15;
        S.bitp = S.bitp + (FIXED[p] >> 16);
        let is i64 as v = FIXED[p] & 0xFFFF;
        clcl[codeLenIdx] = v;
        if (v != 0) {
            space = space - (32 >> v);
            numCodes = numCodes + 1;
            if (space <= 0) { break; }
        }
        i = i + 1;
    }
    if (space != 0) { if (numCodes != 1) { return errno.Z_BADHUFF; } }
    i = 0;
    while (i < alphaLimit) { S.clen[i] = 0; i = i + 1; }
    let is i64 as r = _readHuffmanCodeLengths(S, cast(*i64, &clcl), alphaLimit, S.clen);
    if (r < 0) { return r; }
    return _buildHuff(S, group, tableIdx, 8, S.clen, alphaLimit);
}

fn _readHuffmanCode(S as *Br, alphaMax as i64, alphaLimit as i64, group as *i64, tableIdx as i64) as i64 {
    let is i64 as simpleCodeOrSkip = _take(S, 2);
    if (simpleCodeOrSkip == 1) { return _readSimpleHuffman(S, alphaMax, alphaLimit, group, tableIdx); }
    return _readComplexHuffman(S, alphaLimit, simpleCodeOrSkip, group, tableIdx);
}

fn _decodeContextMap(S as *Br, contextMapSize as i64, contextMap as *i64) as i64 {
    let is i64 as numTrees = _decodeVarLenByte(S) + 1;
    if (numTrees == 1) {
        let is i64 as i with mut = 0;
        while (i < contextMapSize) { contextMap[i] = 0; i = i + 1; }
        return numTrees;
    }
    let is i64 as useRle = _take(S, 1);
    let is i64 as maxRun with mut = 0;
    if (useRle != 0) { maxRun = _take(S, 4) + 1; }
    let is i64 as alphabetSize = numTrees + maxRun;
    let is i64 as tableSize = MHTS[(alphabetSize + 31) >> 5];
    let is *i64 as table = shared.scratch_words(&S.mem, tableSize + 1);
    table[tableSize] = 0;
    let is i64 as rr = _readHuffmanCode(S, alphabetSize, alphabetSize, table, tableSize);
    if (rr < 0) { return rr; }
    let is i64 as i with mut = 0;
    while (i < contextMapSize) {
        let is i64 as code = _readSym(S, table, tableSize);
        if (code == 0) {
            contextMap[i] = 0; i = i + 1;
        } else if (code <= maxRun) {
            let is i64 as reps with mut = (1 << code) + _take(S, code);
            while (reps != 0) {
                if (i >= contextMapSize) { return errno.Z_BADHDR; }
                contextMap[i] = 0; i = i + 1; reps = reps - 1;
            }
        } else {
            contextMap[i] = code - maxRun; i = i + 1;
        }
    }
    if (_take(S, 1) == 1) { _inverseMTF(contextMap, contextMapSize); }
    return numTrees;
}

fn _readBlockLength(S as *Br, group as *i64, tableIdx as i64) as i64 {
    let is i64 as code = _readSym(S, group, tableIdx);
    let is i64 as n = BLNB[code];
    return BLOFF[code] + _take(S, n);
}

fn _decodeBlockTypeAndLength(S as *Br, treeType as i64, numBlockTypes as i64) as i64 {
    let is i64 as offset = 4 + treeType * 2;
    let is i64 as blockType with mut = _readSym(S, S.blockTrees, 2 * treeType);
    let is i64 as result = _readBlockLength(S, S.blockTrees, 2 * treeType + 1);
    if (blockType == 1) { blockType = S.rings[offset + 1] + 1; }
    else if (blockType == 0) { blockType = S.rings[offset]; }
    else { blockType = blockType - 2; }
    if (blockType >= numBlockTypes) { blockType = blockType - numBlockTypes; }
    S.rings[offset] = S.rings[offset + 1];
    S.rings[offset + 1] = blockType;
    return result;
}

fn _decodeLitBlockSwitch(S as *Br) as void {
    S.litBlockLen = _decodeBlockTypeAndLength(S, 0, S.numLitTypes);
    let is i64 as litType = S.rings[5];
    S.contextMapSlice = litType << 6;
    S.litTreeIdx = S.contextMap[S.contextMapSlice] & 0xFF;
    let is i64 as cm = S.contextModes[litType];
    S.ctxLook1 = cm << 9;
    S.ctxLook2 = S.ctxLook1 + 256;
}

fn _decodeCmdBlockSwitch(S as *Br) as void {
    S.cmdBlockLen = _decodeBlockTypeAndLength(S, 1, S.numCmdTypes);
    S.cmdTreeIdx = S.rings[7];
}

fn _decodeDistBlockSwitch(S as *Br) as void {
    S.distBlockLen = _decodeBlockTypeAndLength(S, 2, S.numDistTypes);
    S.distContextMapSlice = S.rings[9] << 2;
}

fn _readMetablockPartition(S as *Br, treeType as i64, numBlockTypes as i64) as i64 {
    let is i64 as offset with mut = S.blockTrees[2 * treeType];
    if (numBlockTypes <= 1) {
        S.blockTrees[2 * treeType + 1] = offset;
        S.blockTrees[2 * treeType + 2] = offset;
        return 1 << 28;
    }
    let is i64 as blockTypeAlpha = numBlockTypes + 2;
    let is i64 as r1 = _readHuffmanCode(S, blockTypeAlpha, blockTypeAlpha, S.blockTrees, 2 * treeType);
    if (r1 < 0) { return r1; }
    offset = offset + r1;
    S.blockTrees[2 * treeType + 1] = offset;
    let is i64 as r2 = _readHuffmanCode(S, 26, 26, S.blockTrees, 2 * treeType + 1);
    if (r2 < 0) { return r2; }
    offset = offset + r2;
    S.blockTrees[2 * treeType + 2] = offset;
    return _readBlockLength(S, S.blockTrees, 2 * treeType + 1);
}

fn _calcDistLut(S as *Br, alphaLimit as i64) as void {
    let is i64 as postfix = 1 << S.npostfix;
    let is i64 as bits with mut = 1;
    let is i64 as half with mut = 0;
    let is i64 as i with mut = 16;
    let is i64 as j with mut = 0;
    while (j < S.ndirect) {
        S.distExtra[i] = 0; S.distOff[i] = j + 1; i = i + 1; j = j + 1;
    }
    while (i < alphaLimit) {
        let is i64 as base = S.ndirect + ((((2 + half) << bits) - 4) << S.npostfix) + 1;
        let is i64 as k with mut = 0;
        while (k < postfix) {
            S.distExtra[i] = bits; S.distOff[i] = base + k; i = i + 1; k = k + 1;
        }
        bits = bits + half;
        half = half ^ 1;
    }
}

fn _treeGroupAllocSize(alphaLimit as i64, n as i64) as i64 {
    return n + n * MHTS[(alphaLimit + 31) >> 5];
}

fn _decodeTreeGroup(S as *Br, group as *i64, alphaMax as i64, alphaLimit as i64, n as i64) as i64 {
    let is i64 as next with mut = n;
    let is i64 as i with mut = 0;
    while (i < n) {
        group[i] = next;
        let is i64 as r = _readHuffmanCode(S, alphaMax, alphaLimit, group, i);
        if (r < 0) { return r; }
        next = next + r;
        i = i + 1;
    }
    return 0;
}

fn _readMetablockHuffman(S as *Br) as i64 {
    S.numLitTypes = _decodeVarLenByte(S) + 1;
    S.litBlockLen = _readMetablockPartition(S, 0, S.numLitTypes);
    if (S.litBlockLen < 0) { return S.litBlockLen; }
    S.numCmdTypes = _decodeVarLenByte(S) + 1;
    S.cmdBlockLen = _readMetablockPartition(S, 1, S.numCmdTypes);
    if (S.cmdBlockLen < 0) { return S.cmdBlockLen; }
    S.numDistTypes = _decodeVarLenByte(S) + 1;
    S.distBlockLen = _readMetablockPartition(S, 2, S.numDistTypes);
    if (S.distBlockLen < 0) { return S.distBlockLen; }

    S.npostfix = _take(S, 2);
    S.ndirect = _take(S, 4) << S.npostfix;
    S.contextModes = shared.scratch_words(&S.mem, S.numLitTypes);
    let is i64 as i with mut = 0;
    while (i < S.numLitTypes) { S.contextModes[i] = _take(S, 2); i = i + 1; }

    let is i64 as cmLen = S.numLitTypes << 6;
    S.contextMap = shared.scratch_words(&S.mem, cmLen);
    let is i64 as numLitTrees = _decodeContextMap(S, cmLen, S.contextMap);
    if (numLitTrees < 0) { return numLitTrees; }
    S.trivialLit = 1;
    i = 0;
    while (i < cmLen) {
        if (S.contextMap[i] != (i >> 6)) { S.trivialLit = 0; i = cmLen; }
        else { i = i + 1; }
    }

    let is i64 as dcmLen = S.numDistTypes << 2;
    S.distContextMap = shared.scratch_words(&S.mem, dcmLen);
    let is i64 as numDistTrees = _decodeContextMap(S, dcmLen, S.distContextMap);
    if (numDistTrees < 0) { return numDistTrees; }

    S.litGroup = shared.scratch_words(&S.mem, _treeGroupAllocSize(256, numLitTrees));
    let is i64 as r1 = _decodeTreeGroup(S, S.litGroup, 256, 256, numLitTrees);
    if (r1 < 0) { return r1; }
    S.cmdGroup = shared.scratch_words(&S.mem, _treeGroupAllocSize(704, S.numCmdTypes));
    let is i64 as r2 = _decodeTreeGroup(S, S.cmdGroup, 704, 704, S.numCmdTypes);
    if (r2 < 0) { return r2; }
    let is i64 as maxDbits with mut = 24;
    if (S.largeWindow == 1) { maxDbits = 62; }
    let is i64 as distAlpha = 16 + S.ndirect + 2 * (maxDbits << S.npostfix);
    S.distGroup = shared.scratch_words(&S.mem, _treeGroupAllocSize(distAlpha, numDistTrees));
    let is i64 as r3 = _decodeTreeGroup(S, S.distGroup, distAlpha, distAlpha, numDistTrees);
    if (r3 < 0) { return r3; }
    _calcDistLut(S, distAlpha);

    S.contextMapSlice = 0;
    S.distContextMapSlice = 0;
    S.ctxLook1 = S.contextModes[0] * 512;
    S.ctxLook2 = S.ctxLook1 + 256;
    S.litTreeIdx = 0;
    S.cmdTreeIdx = 0;
    S.rings[4] = 1; S.rings[5] = 0; S.rings[6] = 1; S.rings[7] = 0; S.rings[8] = 1; S.rings[9] = 0;
    return 0;
}

// transform dictionary word at DICT[wordOffset..] of length wordLen, write into tmp, return length
fn _transformWord(tmp as *u8, wordOffset as i64, wordLen as i64, ti as i64) as i64 {
    let is *u8 as dict = bd.dict();
    let is i64 as prefixIdx = bt.TRANS[3 * ti];
    let is i64 as ttype = bt.TRANS[3 * ti + 1];
    let is i64 as suffixIdx = bt.TRANS[3 * ti + 2];
    let is i64 as o with mut = 0;

    // prefix (length-prefixed string at PFXS[PFXMAP[prefixIdx]])
    let is i64 as p with mut = bt.PFXMAP[prefixIdx];
    let is i64 as plen = cast(i64, bt.PFXS[p]);
    p = p + 1;
    let is i64 as pk with mut = 0;
    while (pk < plen) { tmp[o] = bt.PFXS[p]; o = o + 1; p = p + 1; pk = pk + 1; }

    let is i64 as omitFirst with mut = ttype - 11;
    let is i64 as omitLast with mut = ttype;
    if (omitFirst < 1) { omitFirst = 0; } else if (omitFirst > 9) { omitFirst = 0; }
    if (omitLast < 1) { omitLast = 0; } else if (omitLast > 9) { omitLast = 0; }

    let is i64 as len with mut = wordLen;
    if (omitFirst > len) { omitFirst = len; }
    let is i64 as di with mut = wordOffset + omitFirst;
    len = len - omitFirst - omitLast;
    let is i64 as wordStart = o;
    let is i64 as i with mut = len;
    while (i > 0) { tmp[o] = dict[di]; o = o + 1; di = di + 1; i = i - 1; }

    // ferment: uppercase
    if (ttype == 10 || ttype == 11) {
        let is i64 as uo with mut = wordStart;
        let is i64 as ul with mut = len;
        if (ttype == 10) { ul = 1; }
        while (ul > 0) {
            let is i64 as c0 = cast(i64, tmp[uo]);
            if (c0 < 0xC0) {
                if (c0 >= 97) { if (c0 <= 122) { tmp[uo] = cast(u8, c0 ^ 32); } }
                uo = uo + 1; ul = ul - 1;
            } else if (c0 < 0xE0) {
                tmp[uo + 1] = cast(u8, cast(i64, tmp[uo + 1]) ^ 32);
                uo = uo + 2; ul = ul - 2;
            } else {
                tmp[uo + 2] = cast(u8, cast(i64, tmp[uo + 2]) ^ 5);
                uo = uo + 3; ul = ul - 3;
            }
        }
    }

    // suffix (length-prefixed)
    let is i64 as sp with mut = bt.PFXMAP[suffixIdx];
    let is i64 as slen = cast(i64, bt.PFXS[sp]);
    sp = sp + 1;
    let is i64 as sk with mut = 0;
    while (sk < slen) { tmp[o] = bt.PFXS[sp]; o = o + 1; sp = sp + 1; sk = sk + 1; }
    return o;
}

// ---------------------------------------------------------------- main
fn _decompress(S as *Br, src as *u8, src_len as i64, out as *bytes.Bytes) as i64 {
    S.sorted = shared.scratch_words(&S.mem, 1090);
    S.clen = shared.scratch_words(&S.mem, 1090);
    S.src = src; S.slen = src_len; S.bitp = 0;
    S.inputEnd = 0; S.isUncompressed = 0; S.isMetadata = 0; S.mbLen = 0; S.largeWindow = 0;

    S.blockTrees = shared.scratch_words(&S.mem, 3120);
    S.blockTrees[0] = 7;
    S.distExtra = shared.scratch_words(&S.mem, 700);
    S.distOff = shared.scratch_words(&S.mem, 700);
    S.distRbIdx = 3;
    S.rings[0] = 16; S.rings[1] = 15; S.rings[2] = 11; S.rings[3] = 4;
    S.maxDist = 0;

    let is i64 as windowBits = _decodeWindowBits(S);
    if (windowBits < 0) { return errno.Z_BADHDR; }
    S.maxBackward = (1 << windowBits) - 16;

    let is *u8 as tmp = cast(*u8, shared.scratch_words(&S.mem, 8));

    while (1 == 1) {
        if (S.inputEnd != 0) { break; }
        let is i64 as r = _decodeMetaBlockLength(S);
        if (r < 0) { return r; }
        if (S.mbLen == 0) { if (S.isMetadata == 0) { continue; } }

        if (S.isMetadata != 0) {
            _balign(S);
            S.bitp = S.bitp + S.mbLen * 8;          // skip metadata bytes
            continue;
        }
        if (S.isUncompressed != 0) {
            _balign(S);
            let is i64 as bytePos = S.bitp >> 3;
            if (bytes.bytes_append(out, cast(*u8, cast(i64, src) + bytePos), S.mbLen) < 0) { return errno.Z_OOM; }
            S.bitp = S.bitp + S.mbLen * 8;
            continue;
        }

        let is i64 as rh = _readMetablockHuffman(S);
        if (rh < 0) { return rh; }

        // command loop
        while (S.mbLen > 0) {
            if (S.cmdBlockLen == 0) { _decodeCmdBlockSwitch(S); }
            S.cmdBlockLen = S.cmdBlockLen - 1;
            let is i64 as cmdCode = _readSym(S, S.cmdGroup, S.cmdTreeIdx) << 2;
            let is i64 as insAndCopy = CMD[cmdCode];
            let is i64 as insLength with mut = CMD[cmdCode + 1] + _take(S, insAndCopy & 0xFF);
            let is i64 as copyLength = CMD[cmdCode + 2] + _take(S, insAndCopy >> 8);
            let is i64 as cmdDistCtx = CMD[cmdCode + 3];

            // insert literals
            let is i64 as j with mut = 0;
            if (S.trivialLit != 0) {
                while (j < insLength) {
                    if (S.litBlockLen == 0) { _decodeLitBlockSwitch(S); }
                    S.litBlockLen = S.litBlockLen - 1;
                    let is i64 as lit = _readSym(S, S.litGroup, S.litTreeIdx);
                    if (bytes.bytes_push(out, cast(u8, lit)) < 0) { return errno.Z_OOM; }
                    j = j + 1;
                }
            } else {
                while (j < insLength) {
                    let is i64 as p1 with mut = 0;
                    let is i64 as p2 with mut = 0;
                    if (out.len > 0) { p1 = cast(i64, out.ptr[out.len - 1]); }
                    if (out.len > 1) { p2 = cast(i64, out.ptr[out.len - 2]); }
                    if (S.litBlockLen == 0) { _decodeLitBlockSwitch(S); }
                    let is i64 as litCtx = CTX[S.ctxLook1 + p1] | CTX[S.ctxLook2 + p2];
                    let is i64 as treeIdx = S.contextMap[S.contextMapSlice + litCtx] & 0xFF;
                    S.litBlockLen = S.litBlockLen - 1;
                    let is i64 as lit = _readSym(S, S.litGroup, treeIdx);
                    if (bytes.bytes_push(out, cast(u8, lit)) < 0) { return errno.Z_OOM; }
                    j = j + 1;
                }
            }
            S.mbLen = S.mbLen - insLength;
            if (S.mbLen <= 0) { break; }

            // distance
            let is i64 as distSym with mut = cmdDistCtx;
            let is i64 as distance with mut = 0;
            if (cmdDistCtx < 0) {
                distance = S.rings[S.distRbIdx];
            } else {
                if (S.distBlockLen == 0) { _decodeDistBlockSwitch(S); }
                S.distBlockLen = S.distBlockLen - 1;
                let is i64 as dti = S.distContextMap[S.distContextMapSlice + cmdDistCtx] & 0xFF;
                distSym = _readSym(S, S.distGroup, dti);
                if (distSym < 16) {
                    let is i64 as index = (S.distRbIdx + DSCIO[distSym]) & 3;
                    distance = S.rings[index] + DSCVO[distSym];
                    if (distance < 0) { return errno.Z_BADDIST; }
                } else {
                    let is i64 as extra = S.distExtra[distSym];
                    let is i64 as ebits = _take(S, extra);
                    distance = S.distOff[distSym] + (ebits << S.npostfix);
                }
            }

            S.maxDist = S.maxBackward;
            if (out.len < S.maxBackward) { S.maxDist = out.len; }

            if (distance > S.maxDist) {
                // dictionary reference
                let is i64 as address = distance - S.maxDist - 1;
                let is i64 as wordLen = copyLength;
                if (wordLen > 31) { return errno.Z_BADDIST; }
                let is i64 as shift = DSB[wordLen];
                if (shift == 0) { return errno.Z_BADDIST; }
                let is i64 as mask = (1 << shift) - 1;
                let is i64 as wordIdx = address & mask;
                let is i64 as transformIdx = address >> shift;
                let is i64 as wordOffset = DOFF[wordLen] + wordIdx * wordLen;
                if (transformIdx >= bt.NUM_TRANSFORMS) { return errno.Z_BADDIST; }
                let is i64 as tlen = _transformWord(tmp, wordOffset, wordLen, transformIdx);
                if (bytes.bytes_append(out, tmp, tlen) < 0) { return errno.Z_OOM; }
                S.mbLen = S.mbLen - tlen;
            } else {
                if (distSym > 0) {
                    S.distRbIdx = (S.distRbIdx + 1) & 3;
                    S.rings[S.distRbIdx] = distance;
                }
                if (copyLength > S.mbLen) { return errno.Z_BADDIST; }
                // overlap-safe copy from out[out.len - distance]
                if (distance > out.len) { return errno.Z_BADDIST; }
                if (bytes.bytes_reserve(out, copyLength) < 0) { return errno.Z_OOM; }
                let is i64 as sp with mut = out.len - distance;
                let is i64 as dp with mut = out.len;
                let is i64 as e = out.len + copyLength;
                let is i64 as _p = cast(i64, out.ptr);
                if (distance >= 8) {
                    while (dp + 8 <= e) { cast(*i64, _p + dp)[0] = cast(*i64, _p + sp)[0]; sp = sp + 8; dp = dp + 8; }
                }
                while (dp < e) { out.ptr[dp] = out.ptr[sp]; sp = sp + 1; dp = dp + 1; }
                out.len = e;
                S.mbLen = S.mbLen - copyLength;
            }
        }
    }
    return out.len;
}

fn brotli_decompress(src as *u8, src_len as i64, out as *bytes.Bytes) as i64 {
    _tabs();
    let is Br as st with mut;
    mem.core.memset(cast(*u8, &st), 0, sizeof(Br));
    st.mem = shared.scratch_new();
    let is i64 as r = _decompress(&st, src, src_len, out);
    shared.scratch_free(&st.mem);
    return r;
}

// ---- encode (uncompressed meta-blocks: valid, no compression) ---------
fn _brotli_store(src as *u8, src_len as i64, out as *bytes.Bytes, level as i64) as i64 {
    let is biw.BitWriter as w;
    biw.bw_init(&w, out);
    biw.bw_bits(&w, 0, 1);                  // WBITS = 16

    let is i64 as pos with mut = 0;
    while (pos < src_len) {
        let is i64 as chunk with mut = src_len - pos;
        if (chunk > 16777216) { chunk = 16777216; }   // 2^24
        biw.bw_bits(&w, 0, 1);              // ISLAST = 0
        let is i64 as mlen = chunk - 1;
        let is i64 as nibbles with mut = 4;
        while ((mlen >> (nibbles * 4)) != 0) { nibbles = nibbles + 1; }
        biw.bw_bits(&w, nibbles - 4, 2);    // MNIBBLES
        let is i64 as k with mut = 0;
        while (k < nibbles) { biw.bw_bits(&w, (mlen >> (4 * k)) & 0xF, 4); k = k + 1; }
        biw.bw_bits(&w, 1, 1);              // ISUNCOMPRESSED = 1
        biw.bw_align(&w);
        bytes.bytes_append(out, cast(*u8, cast(i64, src) + pos), chunk);
        pos = pos + chunk;
    }
    biw.bw_bits(&w, 1, 1);                  // ISLAST = 1
    biw.bw_bits(&w, 1, 1);                  // ISLASTEMPTY = 1
    biw.bw_align(&w);
    return out.len;
}

fn brotli_cleanup() as void {
    if (CMD != cast(*i64, 0)) { mem.core.munmap(cast(*u8, CMD), 704 * 4 * 8); CMD = cast(*i64, 0); }
    if (BLOFF != cast(*i64, 0)) { mem.core.munmap(cast(*u8, BLOFF), 26 * 8); BLOFF = cast(*i64, 0); }
    if (BLNB != cast(*i64, 0)) { mem.core.munmap(cast(*u8, BLNB), 26 * 8); BLNB = cast(*i64, 0); }
    if (INSNB != cast(*i64, 0)) { mem.core.munmap(cast(*u8, INSNB), 24 * 8); INSNB = cast(*i64, 0); }
    if (CPYNB != cast(*i64, 0)) { mem.core.munmap(cast(*u8, CPYNB), 24 * 8); CPYNB = cast(*i64, 0); }
    if (DSCIO != cast(*i64, 0)) { mem.core.munmap(cast(*u8, DSCIO), 16 * 8); DSCIO = cast(*i64, 0); }
    if (DSCVO != cast(*i64, 0)) { mem.core.munmap(cast(*u8, DSCVO), 16 * 8); DSCVO = cast(*i64, 0); }
    if (FIXED != cast(*i64, 0)) { mem.core.munmap(cast(*u8, FIXED), 16 * 8); FIXED = cast(*i64, 0); }
    if (CLCO != cast(*i64, 0)) { mem.core.munmap(cast(*u8, CLCO), 18 * 8); CLCO = cast(*i64, 0); }
    if (DSB != cast(*i64, 0)) { mem.core.munmap(cast(*u8, DSB), 32 * 8); DSB = cast(*i64, 0); }
    if (DOFF != cast(*i64, 0)) { mem.core.munmap(cast(*u8, DOFF), 32 * 8); DOFF = cast(*i64, 0); }
    if (MHTS != cast(*i64, 0)) { mem.core.munmap(cast(*u8, MHTS), 23 * 8); MHTS = cast(*i64, 0); }
    if (CTX != cast(*i64, 0)) { mem.core.munmap(cast(*u8, CTX), 2048 * 8); CTX = cast(*i64, 0); }
    atomic_store(&_tab_ready, 0);
}

// ===================== BROTLI ENCODER (real) ===========================
// Phase 1: one compressed meta-block, Huffman-coded literals, a single
// insert-only command (no copies), trivial command/distance trees.
// Mirrors the decoder exactly: codes are LSB-first canonical via _nextKey.

let is *i64 as _ehead2 with mut;
let is *i64 as _eprev2 with mut;

// length-limited Huffman (bzip2 BZ2_hbMakeCodeLengths over active symbols).
fn _bhlen(freq as *i64, nsym as i64, maxLen as i64, out_len as *i64) as void {
    let is i64 as i with mut = 0;
    while (i < nsym) { out_len[i] = 0; i = i + 1; }
    let is i64 as nAct with mut = 0;
    i = 0; while (i < nsym) { if (freq[i] > 0) { nAct = nAct + 1; } i = i + 1; }
    if (nAct == 0) { return; }
    if (nAct == 1) { i = 0; while (i < nsym) { if (freq[i] > 0) { out_len[i] = 1; break; } i = i + 1; } return; }
    let is i64 as asz = nAct * 2 + 8;
    let is *i64 as amap = _ia(nAct + 1);
    let is *i64 as heap = _ia(asz);
    let is *i64 as weight = _ia(asz);
    let is *i64 as parent = _ia(asz);
    let is i64 as alphaSize = nAct;
    let is i64 as j with mut = 0;
    i = 0;
    while (i < nsym) { if (freq[i] > 0) { amap[j] = i; weight[j + 1] = freq[i] << 8; j = j + 1; } i = i + 1; }
    while (1 == 1) {
        let is i64 as nNodes with mut = alphaSize;
        let is i64 as nHeap with mut = 0;
        heap[0] = 0; weight[0] = 0; parent[0] = 0 - 2;
        i = 1;
        while (i <= alphaSize) {
            parent[i] = 0 - 1; nHeap = nHeap + 1; heap[nHeap] = i;
            let is i64 as zz with mut = nHeap;
            let is i64 as tmp = heap[zz];
            while (weight[tmp] < weight[heap[zz >> 1]]) { heap[zz] = heap[zz >> 1]; zz = zz >> 1; }
            heap[zz] = tmp;
            i = i + 1;
        }
        while (nHeap > 1) {
            let is i64 as n1 = heap[1]; heap[1] = heap[nHeap]; nHeap = nHeap - 1;
            let is i64 as zz1 with mut = 1;
            let is i64 as tmp1 = heap[zz1];
            while (1 == 1) {
                let is i64 as yy with mut = zz1 << 1;
                if (yy > nHeap) { break; }
                if (yy < nHeap) { if (weight[heap[yy + 1]] < weight[heap[yy]]) { yy = yy + 1; } }
                if (weight[tmp1] < weight[heap[yy]]) { break; }
                heap[zz1] = heap[yy]; zz1 = yy;
            }
            heap[zz1] = tmp1;
            let is i64 as n2 = heap[1]; heap[1] = heap[nHeap]; nHeap = nHeap - 1;
            let is i64 as zz2 with mut = 1;
            let is i64 as tmp2 = heap[zz2];
            while (1 == 1) {
                let is i64 as yy with mut = zz2 << 1;
                if (yy > nHeap) { break; }
                if (yy < nHeap) { if (weight[heap[yy + 1]] < weight[heap[yy]]) { yy = yy + 1; } }
                if (weight[tmp2] < weight[heap[yy]]) { break; }
                heap[zz2] = heap[yy]; zz2 = yy;
            }
            heap[zz2] = tmp2;
            nNodes = nNodes + 1;
            parent[n1] = nNodes; parent[n2] = nNodes;
            let is i64 as w1 = weight[n1];
            let is i64 as w2 = weight[n2];
            let is i64 as lo1 = w1 & 0xFF;
            let is i64 as lo2 = w2 & 0xFF;
            let is i64 as mx with mut = lo1;
            if (lo2 > mx) { mx = lo2; }
            weight[nNodes] = ((w1 & 0xFFFFFF00) + (w2 & 0xFFFFFF00)) | (1 + mx);
            parent[nNodes] = 0 - 1; nHeap = nHeap + 1; heap[nHeap] = nNodes;
            let is i64 as zz3 with mut = nHeap;
            let is i64 as tmp3 = heap[zz3];
            while (weight[tmp3] < weight[heap[zz3 >> 1]]) { heap[zz3] = heap[zz3 >> 1]; zz3 = zz3 >> 1; }
            heap[zz3] = tmp3;
        }
        let is i64 as tooLong with mut = 0;
        i = 1;
        while (i <= alphaSize) {
            let is i64 as jj with mut = 0;
            let is i64 as k with mut = i;
            while (parent[k] >= 0) { k = parent[k]; jj = jj + 1; }
            out_len[amap[i - 1]] = jj;
            if (jj > maxLen) { tooLong = 1; }
            i = i + 1;
        }
        if (tooLong == 0) { break; }
        i = 1;
        while (i <= alphaSize) {
            let is i64 as jj with mut = weight[i] >> 8;
            jj = 1 + (jj / 2);
            weight[i] = jj << 8;
            i = i + 1;
        }
    }
    mem.core.munmap(cast(*u8, amap), (nAct + 1) * 8);
    mem.core.munmap(cast(*u8, heap), asz * 8);
    mem.core.munmap(cast(*u8, weight), asz * 8);
    mem.core.munmap(cast(*u8, parent), asz * 8);
}

// LSB-first canonical codes (mirrors _buildHuff's _nextKey assignment).
fn _bhcodes(clen as *i64, nsym as i64, code as *i64) as void {
    let is i64 as key with mut = 0;
    let is i64 as len with mut = 1;
    while (len <= 15) {
        let is i64 as i with mut = 0;
        while (i < nsym) {
            if (clen[i] == len) { code[i] = key; key = _nextKey(key, len); }
            i = i + 1;
        }
        len = len + 1;
    }
}

// emit one clcl value using the fixed code-length-code prefix (from FIXED).
fn _emit_clcl(w as *biw.BitWriter, v as i64) as void {
    if (v == 0) { biw.bw_bits(w, 0, 2); }
    else if (v == 1) { biw.bw_bits(w, 7, 4); }
    else if (v == 2) { biw.bw_bits(w, 3, 3); }
    else if (v == 3) { biw.bw_bits(w, 2, 2); }
    else if (v == 4) { biw.bw_bits(w, 1, 2); }
    else { biw.bw_bits(w, 15, 4); }
}

// Emit a Huffman code description for clen[0..nsym). A single-symbol code is
// incomplete as a complex code, so it must use the 1-symbol simple form.
fn _emit_tree(w as *biw.BitWriter, clen as *i64, nsym as i64) as void {
    let is i64 as nzc with mut = 0;
    let is i64 as theSym with mut = 0;
    let is i64 as q with mut = 0;
    while (q < nsym) { if (clen[q] > 0) { nzc = nzc + 1; theSym = q; } q = q + 1; }
    if (nzc == 1) {
        let is i64 as maxBits = 1 + _log2floor(nsym - 1);
        biw.bw_bits(w, 1, 2);                       // simpleCodeOrSkip = 1 (simple)
        biw.bw_bits(w, 0, 2);                       // numSymbols-1 = 0 (1 symbol)
        biw.bw_bits(w, theSym, maxBits);
        return;
    }
    biw.bw_bits(w, 0, 2);                          // simpleCodeOrSkip = 0 (complex, skip 0)
    let is i64 as lastNZ with mut = 0;
    let is i64 as i with mut = 0;
    while (i < nsym) { if (clen[i] > 0) { lastNZ = i; } i = i + 1; }
    // clcl frequencies over the code-length tokens [0..lastNZ]
    let is [18]i64 as clf;
    i = 0; while (i < 18) { clf[i] = 0; i = i + 1; }
    i = 0; while (i <= lastNZ) { clf[clen[i]] = clf[clen[i]] + 1; i = i + 1; }
    let is [18]i64 as clcl;
    _bhlen(cast(*i64, &clf), 18, 5, cast(*i64, &clcl));
    let is [18]i64 as clcode;
    _bhcodes(cast(*i64, &clcl), 18, cast(*i64, &clcode));
    let is i64 as numCL with mut = 0;
    i = 0; while (i < 18) { if (clcl[i] > 0) { numCL = numCL + 1; } i = i + 1; }
    if (numCL == 1) {
        // single code-length-code: the decoder never reaches space<=0, so it
        // reads all 18 clcl entries and then consumes 0 bits per token.
        i = 0; while (i < 18) { _emit_clcl(w, clcl[CLCO[i]]); i = i + 1; }
    } else {
        let is i64 as lastCL with mut = 0;
        i = 0; while (i < 18) { if (clcl[CLCO[i]] > 0) { lastCL = i; } i = i + 1; }
        i = 0; while (i <= lastCL) { _emit_clcl(w, clcl[CLCO[i]]); i = i + 1; }
        // emit the symbol code lengths as clcl-coded literal tokens
        i = 0;
        while (i <= lastNZ) {
            let is i64 as t = clen[i];
            biw.bw_bits(w, clcode[t], clcl[t]);
            i = i + 1;
        }
    }
}

// find any command symbol whose insert offset matches (copy is unused: the
// meta-block ends right after the insert, so the copy never executes).
fn _find_cmd(insOffVal as i64) as i64 {
    let is i64 as c with mut = 0;
    while (c < 704) {
        if (CMD[c * 4 + 1] == insOffVal) { return c; }
        c = c + 1;
    }
    return 0 - 1;
}

fn _brotli_huff(src as *u8, src_len as i64, out as *bytes.Bytes, level as i64) as i64 {
    _tabs();
    let is biw.BitWriter as w;
    biw.bw_init(&w, out);
    biw.bw_bits(&w, 0, 1);                          // WBITS = 16

    if (src_len == 0) {
        biw.bw_bits(&w, 1, 1); biw.bw_bits(&w, 1, 1);   // ISLAST, ISLASTEMPTY
        biw.bw_align(&w);
        return out.len;
    }

    // insert/copy offset tables
    let is [24]i64 as insOff; let is [24]i64 as cpyOff;
    insOff[0] = 0; cpyOff[0] = 2;
    let is i64 as t with mut = 0;
    while (t < 23) {
        insOff[t + 1] = insOff[t] + (1 << INSNB[t]);
        cpyOff[t + 1] = cpyOff[t] + (1 << CPYNB[t]);
        t = t + 1;
    }

    // one meta-block covering the whole input (assume < 2^24)
    biw.bw_bits(&w, 1, 1);                          // ISLAST = 1
    biw.bw_bits(&w, 0, 1);                          // ISLASTEMPTY = 0
    let is i64 as mlen = src_len - 1;
    let is i64 as nibbles with mut = 4;
    while ((mlen >> (nibbles * 4)) != 0) { nibbles = nibbles + 1; }
    biw.bw_bits(&w, nibbles - 4, 2);
    let is i64 as k with mut = 0;
    while (k < nibbles) { biw.bw_bits(&w, (mlen >> (4 * k)) & 0xF, 4); k = k + 1; }
    // (ISUNCOMPRESSED bit is only present when not ISLAST)

    // block-type counts: NBLTYPESL=I=D=1 (single bit 0 each)
    biw.bw_bits(&w, 0, 1);                          // NBLTYPESL = 1
    biw.bw_bits(&w, 0, 1);                          // NBLTYPESI = 1
    biw.bw_bits(&w, 0, 1);                          // NBLTYPESD = 1
    biw.bw_bits(&w, 0, 2);                          // NPOSTFIX = 0
    biw.bw_bits(&w, 0, 4);                          // NDIRECT = 0
    biw.bw_bits(&w, 0, 2);                          // context mode for literal block type 0 = LSB6

    // NTREESL = 1, NTREESD = 1 (single bit 0 -> no context map)
    biw.bw_bits(&w, 0, 1);
    biw.bw_bits(&w, 0, 1);

    // --- literal tree (emitted first): complex Huffman over 256 bytes ---
    let is *i64 as lfreq = _ia(256);
    let is i64 as i with mut = 0;
    while (i < src_len) { lfreq[cast(i64, src[i])] = lfreq[cast(i64, src[i])] + 1; i = i + 1; }
    let is *i64 as lclen = _ia(256);
    let is *i64 as lcode = _ia(256);
    _bhlen(lfreq, 256, 15, lclen);
    _bhcodes(lclen, 256, lcode);
    _emit_tree(&w, lclen, 256);

    // --- command tree: simple, 1 symbol (an insert command) ---
    let is i64 as ic with mut = 0;
    while (ic < 23 && insOff[ic + 1] <= src_len) { ic = ic + 1; }
    let is i64 as cmdSym = _find_cmd(insOff[ic]);
    let is i64 as insNbits = CMD[cmdSym * 4] & 0xFF;
    let is i64 as cpyNbits = CMD[cmdSym * 4] >> 8;
    biw.bw_bits(&w, 1, 2);                          // simpleCodeOrSkip = 1 (simple)
    biw.bw_bits(&w, 0, 2);                          // numSymbols-1 = 0 (1 symbol)
    biw.bw_bits(&w, cmdSym, 10);                    // maxBits=10 for alpha 704

    // --- distance tree: simple, 1 symbol (symbol 0) ---
    biw.bw_bits(&w, 1, 2);
    biw.bw_bits(&w, 0, 2);
    biw.bw_bits(&w, 0, 6);                          // maxBits=6 for alpha 64

    // --- command: insert all src_len literals (copy never executes) ---
    // (single-symbol command tree consumes 0 bits for the symbol)
    biw.bw_bits(&w, src_len - insOff[ic], insNbits);   // insert extra bits
    if (cpyNbits > 0) { biw.bw_bits(&w, 0, cpyNbits); }   // copy extra bits (unused)

    // --- the literals ---
    i = 0;
    while (i < src_len) {
        let is i64 as c = cast(i64, src[i]);
        biw.bw_bits(&w, lcode[c], lclen[c]);
        i = i + 1;
    }
    biw.bw_align(&w);
    mem.core.munmap(cast(*u8, lfreq), 256 * 8);
    mem.core.munmap(cast(*u8, lclen), 256 * 8);
    mem.core.munmap(cast(*u8, lcode), 256 * 8);
    return out.len;
}

// Public entry: emit the smaller of the Huffman-literal block and the
// uncompressed (store) block, so output is never larger than store mode.
fn brotli_compress(src as *u8, src_len as i64, out as *bytes.Bytes, level as i64) as i64 {
    let is bytes.Bytes as huff = bytes.bytes_new(256);
    _brotli_huff2(src, src_len, &huff, level);
    let is bytes.Bytes as store = bytes.bytes_new(256);
    _brotli_store(src, src_len, &store, level);
    if (huff.len <= store.len) { bytes.bytes_append(out, huff.ptr, huff.len); }
    else { bytes.bytes_append(out, store.ptr, store.len); }
    bytes.bytes_free(&huff);
    bytes.bytes_free(&store);
    return out.len;
}

// ===================== BROTLI ENCODER phase 2 (matches) ================
// Adds LZ77: insert-and-copy commands with explicit distances (codes 16+,
// NPOSTFIX=0/NDIRECT=0, so the ring is never referenced), Huffman trees over
// literals, commands and distances. WBITS=22 so distances reach 4 MB back.

let is *i64 as _distOffE with mut;     // distOff[16..63]
let is *i64 as _distExtE with mut;     // distExtra[16..63]

fn _build_dist_lut() as void {
    if (cast(i64, _distOffE) != 0) { return; }
    _distOffE = _ia(64); _distExtE = _ia(64);
    let is i64 as i with mut = 16;
    let is i64 as bits with mut = 1;
    let is i64 as half with mut = 0;
    while (i < 64) {
        let is i64 as base = ((2 + half) << bits) - 4 + 1;
        _distExtE[i] = bits; _distOffE[i] = base;
        i = i + 1; bits = bits + half; half = half ^ 1;
    }
}

fn _dist_code(d as i64) as i64 {
    let is i64 as c with mut = 16;
    while (c < 63) {
        if (_distOffE[c + 1] > d) { break; }
        c = c + 1;
    }
    return c;
}

// command symbol for (insOffVal, cpyOffVal); needExplicit -> distCtx >= 0.
fn _cmd_symbol(icode as i64, ccode as i64, needExplicit as i64) as i64 {
    return _cmdLut[needExplicit * 1024 + icode * 32 + ccode];
}

fn _nz_one(arr as *i64, n as i64) as i64 {
    let is i64 as c with mut = 0;
    let is i64 as i with mut = 0;
    while (i < n) { if (arr[i] > 0) { c = c + 1; } i = i + 1; }
    if (c == 1) { return 1; }
    return 0;
}

// Longest match at pos (already inserted); explicit hash chain via prev.
// Match length of src[a..] vs src[b..] up to maxLen, 8 bytes at a time.
fn _match_run(src as *u8, a as i64, b as i64, maxLen as i64) as i64 {
    let is i64 as l with mut = 0;
    while (l + 8 <= maxLen) {
        let is i64 as xa = cast(*i64, cast(i64, src) + a + l)[0];
        let is i64 as xb = cast(*i64, cast(i64, src) + b + l)[0];
        if (xa != xb) {
            let is i64 as x with mut = xa ^ xb;
            let is i64 as j with mut = 0;
            while ((x & 0xFF) == 0) { x = x >> 8; j = j + 1; }
            return l + j;
        }
        l = l + 8;
    }
    while (l < maxLen) { if (src[a + l] != src[b + l]) { break; } l = l + 1; }
    return l;
}

fn _bmatch(src as *u8, pos as i64, src_len as i64, prev as *i64, distOut as *i64) as i64 {
    let is i64 as cand with mut = prev[pos];
    let is i64 as bestLen with mut = 0;
    let is i64 as bestDist with mut = 0;
    let is i64 as chain with mut = 0;
    while (cand >= 0) {
        if (chain >= 128) { break; }
        if (bestLen == 0 || src[cand + bestLen] == src[pos + bestLen]) {
            let is i64 as l = _match_run(src, cand, pos, src_len - pos);
            if (l > bestLen) { bestLen = l; bestDist = pos - cand; if (pos + bestLen >= src_len) { break; } }
        }
        cand = prev[cand];
        chain = chain + 1;
    }
    distOut[0] = bestDist;
    return bestLen;
}

fn _brotli_huff2(src as *u8, src_len as i64, out as *bytes.Bytes, level as i64) as i64 {
    _tabs();
    _build_dist_lut();
    if (src_len < 16) { return _brotli_huff(src, src_len, out, level); }

    // insert/copy offset tables
    let is [24]i64 as insOff; let is [24]i64 as cpyOff;
    insOff[0] = 0; cpyOff[0] = 2;
    let is i64 as t with mut = 0;
    while (t < 23) {
        insOff[t + 1] = insOff[t] + (1 << INSNB[t]);
        cpyOff[t + 1] = cpyOff[t] + (1 << CPYNB[t]);
        t = t + 1;
    }

    // --- match finding -> command list (insRun, copyLen, dist) ---
    let is i64 as HSIZE with imut = 65536;
    let is *i64 as head = cast(*i64, mem.core.mmap_anon(HSIZE * 8));
    let is *i64 as prev = cast(*i64, mem.core.mmap_anon((src_len + 1) * 8));
    mem.core.memset(cast(*u8, head), cast(i32, 0xFF), HSIZE * 8);
    let is i64 as maxCmd = src_len + 16;
    let is *i64 as cmInsRun = _ia(maxCmd);
    let is *i64 as cmCopy = _ia(maxCmd);
    let is *i64 as cmDist = _ia(maxCmd);
    let is i64 as ncmd with mut = 0;
    let is *u8 as lits = mem.core.mmap_anon(src_len + 16);
    let is i64 as nlit with mut = 0;

    let is i64 as pos with mut = 0;
    let is i64 as anchor with mut = 0;
    let is i64 as hins with mut = 0 - 1;
    while (pos + 4 <= src_len) {
        let is i64 as h = ((cast(i64, src[pos]) << 11) ^ (cast(i64, src[pos + 1]) << 7)
                          ^ (cast(i64, src[pos + 2]) << 3) ^ cast(i64, src[pos + 3])) & (HSIZE - 1);
        prev[pos] = head[h]; head[h] = pos; if (pos > hins) { hins = pos; }
        let is i64 as bestDist with mut = 0;
        let is i64 as bestLen with mut = _bmatch(src, pos, src_len, prev, &bestDist);
        if (bestLen < 4) { pos = pos + 1; }
        else {
            // 1-step lazy: defer while the next position has a strictly longer match
            while (pos + 5 <= src_len) {
                let is i64 as p1 = pos + 1;
                let is i64 as h1 = ((cast(i64, src[p1]) << 11) ^ (cast(i64, src[p1 + 1]) << 7)
                                   ^ (cast(i64, src[p1 + 2]) << 3) ^ cast(i64, src[p1 + 3])) & (HSIZE - 1);
                prev[p1] = head[h1]; head[h1] = p1; if (p1 > hins) { hins = p1; }
                let is i64 as d1 with mut = 0;
                let is i64 as l1 = _bmatch(src, p1, src_len, prev, &d1);
                if (l1 > bestLen) { pos = p1; bestLen = l1; bestDist = d1; }
                else { break; }
            }
            let is i64 as insRun with mut = pos - anchor;
            let is i64 as a with mut = anchor;
            while (a < pos) { lits[nlit] = src[a]; nlit = nlit + 1; a = a + 1; }
            let is i64 as copyLen with mut = bestLen;
            let is i64 as ccode = _copy_code_local(cpyOff, copyLen);
            let is i64 as icode = _copy_code_local2(insOff, insRun);
            if ((icode >> 3) == 0 && (ccode >> 3) == 2) {
                let is i64 as need = 10 - insRun;
                let is i64 as b with mut = pos;
                let is i64 as kk with mut = 0;
                while (kk < need) { lits[nlit] = src[b]; nlit = nlit + 1; b = b + 1; kk = kk + 1; }
                insRun = 10; copyLen = copyLen - need;
            }
            cmInsRun[ncmd] = insRun; cmCopy[ncmd] = copyLen; cmDist[ncmd] = bestDist; ncmd = ncmd + 1;
            let is i64 as k with mut = pos + 1;
            while (k < pos + bestLen) {
                if (k > hins && k + 4 <= src_len) {
                    let is i64 as hk = ((cast(i64, src[k]) << 11) ^ (cast(i64, src[k + 1]) << 7)
                                       ^ (cast(i64, src[k + 2]) << 3) ^ cast(i64, src[k + 3])) & (HSIZE - 1);
                    prev[k] = head[hk]; head[hk] = k; hins = k;
                }
                k = k + 1;
            }
            pos = pos + bestLen; anchor = pos;
        }
    }
    // trailing literals -> final insert-only command (only if any remain)
    if (src_len - anchor > 0) {
        let is i64 as a2 with mut = anchor;
        while (a2 < src_len) { lits[nlit] = src[a2]; nlit = nlit + 1; a2 = a2 + 1; }
        cmInsRun[ncmd] = src_len - anchor; cmCopy[ncmd] = 0; cmDist[ncmd] = 0; ncmd = ncmd + 1;
    }

    // --- symbol frequencies ---
    let is *i64 as cmdFreq = _ia(704);
    let is *i64 as litFreq = _ia(256);
    let is *i64 as distFreq = _ia(64);
    let is i64 as ci with mut = 0;
    while (ci < nlit) { litFreq[cast(i64, lits[ci])] = litFreq[cast(i64, lits[ci])] + 1; ci = ci + 1; }
    ci = 0;
    let is i64 as lastDist with mut = 0;
    while (ci < ncmd) {
        let is i64 as icode = _copy_code_local2(insOff, cmInsRun[ci]);
        let is i64 as last with mut = 0; if (cmDist[ci] == 0 && cmCopy[ci] == 0) { last = 1; }
        let is i64 as ccode with mut = 0;
        if (last == 1) { ccode = 0; } else { ccode = _copy_code_local(cpyOff, cmCopy[ci]); }
        let is i64 as needExp with mut = 1;
        if (last == 1) { needExp = 0; }
        let is i64 as cs = _cmd_symbol(icode, ccode, needExp);
        cmdFreq[cs] = cmdFreq[cs] + 1;
        if (last == 0) {
            let is i64 as ds with mut = 0;
            if (cmDist[ci] == lastDist) { ds = 0; }              // rep0: reuse last distance
            else { ds = _dist_code(cmDist[ci]); lastDist = cmDist[ci]; }
            distFreq[ds] = distFreq[ds] + 1;
        }
        ci = ci + 1;
    }

    // --- build Huffman trees ---
    let is *i64 as lclen = _ia(256); let is *i64 as lcode = _ia(256);
    _bhlen(litFreq, 256, 15, lclen); _bhcodes(lclen, 256, lcode);
    let is *i64 as cclen = _ia(704); let is *i64 as ccode2 = _ia(704);
    _bhlen(cmdFreq, 704, 15, cclen); _bhcodes(cclen, 704, ccode2);
    let is *i64 as dclen = _ia(64); let is *i64 as dcode = _ia(64);
    _bhlen(distFreq, 64, 15, dclen); _bhcodes(dclen, 64, dcode);
    // single-symbol trees: the decoder consumes 0 bits per symbol
    let is i64 as litSingle = _nz_one(lclen, 256);
    let is i64 as cmdSingle = _nz_one(cclen, 704);
    let is i64 as distSingle = _nz_one(dclen, 64);

    // --- emit meta-block ---
    let is biw.BitWriter as w;
    biw.bw_init(&w, out);
    biw.bw_bits(&w, 1, 1); biw.bw_bits(&w, 5, 3);  // WBITS = 22
    biw.bw_bits(&w, 1, 1); biw.bw_bits(&w, 0, 1);  // ISLAST=1, ISLASTEMPTY=0
    let is i64 as mlen = src_len - 1;
    let is i64 as nibbles with mut = 4;
    while ((mlen >> (nibbles * 4)) != 0) { nibbles = nibbles + 1; }
    biw.bw_bits(&w, nibbles - 4, 2);
    let is i64 as kk with mut = 0;
    while (kk < nibbles) { biw.bw_bits(&w, (mlen >> (4 * kk)) & 0xF, 4); kk = kk + 1; }
    biw.bw_bits(&w, 0, 1); biw.bw_bits(&w, 0, 1); biw.bw_bits(&w, 0, 1);  // NBLTYPES L/I/D = 1
    biw.bw_bits(&w, 0, 2); biw.bw_bits(&w, 0, 4);  // NPOSTFIX=0, NDIRECT=0
    biw.bw_bits(&w, 0, 2);                          // context mode LSB6
    biw.bw_bits(&w, 0, 1); biw.bw_bits(&w, 0, 1);  // NTREESL=1, NTREESD=1 (context maps)
    _emit_tree(&w, lclen, 256);                     // literal tree
    _emit_tree(&w, cclen, 704);                     // command tree
    _emit_tree(&w, dclen, 64);                      // distance tree

    // --- emit commands ---
    let is i64 as litCursor with mut = 0;
    let is i64 as lastDistE with mut = 0;
    ci = 0;
    while (ci < ncmd) {
        let is i64 as insRun = cmInsRun[ci];
        let is i64 as last with mut = 0; if (cmDist[ci] == 0 && cmCopy[ci] == 0) { last = 1; }
        let is i64 as icode = _copy_code_local2(insOff, insRun);
        let is i64 as ccode with mut = 0;
        if (last == 1) { ccode = 0; } else { ccode = _copy_code_local(cpyOff, cmCopy[ci]); }
        let is i64 as needExp with mut = 1;
        if (last == 1) { needExp = 0; }
        let is i64 as cs = _cmd_symbol(icode, ccode, needExp);
        if (cmdSingle == 0) { biw.bw_bits(&w, ccode2[cs], cclen[cs]); }   // command symbol
        if (INSNB[icode] > 0) { biw.bw_bits(&w, insRun - insOff[icode], INSNB[icode]); }
        if (CPYNB[ccode] > 0) {
            let is i64 as cv with mut = 0;
            if (last == 0) { cv = cmCopy[ci] - cpyOff[ccode]; }
            biw.bw_bits(&w, cv, CPYNB[ccode]);
        }
        // literals
        let is i64 as j with mut = 0;
        while (j < insRun) {
            let is i64 as lc = cast(i64, lits[litCursor]);
            if (litSingle == 0) { biw.bw_bits(&w, lcode[lc], lclen[lc]); }
            litCursor = litCursor + 1; j = j + 1;
        }
        // distance (intermediate commands only); rep0 when unchanged
        if (last == 0) {
            let is i64 as ds with mut = 0;
            if (cmDist[ci] == lastDistE) { ds = 0; }
            else { ds = _dist_code(cmDist[ci]); lastDistE = cmDist[ci]; }
            if (distSingle == 0) { biw.bw_bits(&w, dcode[ds], dclen[ds]); }
            if (ds >= 16) { if (_distExtE[ds] > 0) { biw.bw_bits(&w, cmDist[ci] - _distOffE[ds], _distExtE[ds]); } }
        }
        ci = ci + 1;
    }
    biw.bw_align(&w);
    mem.core.munmap(cast(*u8, head), HSIZE * 8);
    mem.core.munmap(cast(*u8, prev), (src_len + 1) * 8);
    return out.len;
}

fn _copy_code_local(cpyOff as *i64, len as i64) as i64 {
    let is i64 as c with mut = 0;
    while (c < 23) { if (cpyOff[c + 1] > len) { break; } c = c + 1; }
    return c;
}
fn _copy_code_local2(insOff as *i64, run as i64) as i64 {
    let is i64 as c with mut = 0;
    while (c < 23) { if (insOff[c + 1] > run) { break; } c = c + 1; }
    return c;
}
