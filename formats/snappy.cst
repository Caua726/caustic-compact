// =======================================================
// caustic-compact/formats/snappy.cst
// Snappy decompression (the raw block format). A varint preamble gives the
// uncompressed length, followed by elements: literals (tag type 0) and
// back-reference copies (types 1/2/3 with 1/2/4-byte offsets). Copies are
// overlap-safe.
//   snappy_decompress(src, src_len, out) -> bytes written, or negative error.
// =======================================================

use "../core/errno.cst" as errno;
use "../core/bytes.cst" as bytes;
use "../core/checksum.cst" as checksum;
use "std/mem.cst" only bins, core as mem;

fn _copy_back(out as *bytes.Bytes, offset as i64, length as i64) as i64 {
    if (offset > out.len) { return errno.Z_BADDIST; }
    if (offset == 0) { return errno.Z_BADDIST; }
    if (bytes.bytes_reserve(out, length) < 0) { return errno.Z_OOM; }
    let is i64 as s with mut = out.len - offset;
    let is i64 as d with mut = out.len;
    let is i64 as e = out.len + length;
    while (d < e) {
        out.ptr[d] = out.ptr[s];
        s = s + 1;
        d = d + 1;
    }
    out.len = e;
    return 0;
}

fn snappy_decompress(src as *u8, src_len as i64, out as *bytes.Bytes) as i64 {
    // varint preamble: uncompressed length (LSB groups of 7 bits)
    let is i64 as pos with mut = 0;
    let is i64 as ulen with mut = 0;
    let is i64 as shift with mut = 0;
    while (pos < src_len) {
        let is i64 as b = cast(i64, src[pos]);
        pos = pos + 1;
        ulen = ulen | ((b & 0x7F) << shift);
        shift = shift + 7;
        if ((b & 0x80) == 0) { break; }
    }
    if (ulen > 0) {
        if (bytes.bytes_reserve(out, ulen) < 0) { return errno.Z_OOM; }
    }

    while (pos < src_len) {
        let is i64 as tag = cast(i64, src[pos]);
        pos = pos + 1;
        let is i64 as typ = tag & 3;

        if (typ == 0) {
            let is i64 as lf = tag >> 2;
            let is i64 as length with mut = 0;
            if (lf < 60) {
                length = lf + 1;
            } else {
                let is i64 as nb = lf - 59;
                if (pos + nb > src_len) { return errno.Z_EOF; }
                let is i64 as v with mut = 0;
                let is i64 as i with mut = 0;
                while (i < nb) {
                    v = v | (cast(i64, src[pos + i]) << (8 * i));
                    i = i + 1;
                }
                pos = pos + nb;
                length = v + 1;
            }
            if (pos + length > src_len) { return errno.Z_EOF; }
            if (bytes.bytes_append(out, cast(*u8, cast(i64, src) + pos), length) < 0) { return errno.Z_OOM; }
            pos = pos + length;
        } else if (typ == 1) {
            let is i64 as length = ((tag >> 2) & 7) + 4;
            if (pos >= src_len) { return errno.Z_EOF; }
            let is i64 as offset = ((tag >> 5) << 8) | cast(i64, src[pos]);
            pos = pos + 1;
            let is i64 as r = _copy_back(out, offset, length);
            if (r < 0) { return r; }
        } else if (typ == 2) {
            let is i64 as length = (tag >> 2) + 1;
            if (pos + 2 > src_len) { return errno.Z_EOF; }
            let is i64 as offset = cast(i64, src[pos]) | (cast(i64, src[pos + 1]) << 8);
            pos = pos + 2;
            let is i64 as r = _copy_back(out, offset, length);
            if (r < 0) { return r; }
        } else {
            let is i64 as length = (tag >> 2) + 1;
            if (pos + 4 > src_len) { return errno.Z_EOF; }
            let is i64 as offset = cast(i64, src[pos]) | (cast(i64, src[pos + 1]) << 8)
                                 | (cast(i64, src[pos + 2]) << 16) | (cast(i64, src[pos + 3]) << 24);
            pos = pos + 4;
            let is i64 as r = _copy_back(out, offset, length);
            if (r < 0) { return r; }
        }
    }

    if (out.len != ulen) { return errno.Z_BADLEN; }
    return out.len;
}

// ---- encode -----------------------------------------------------------
fn _sn_hash(src as *u8, p as i64) as i64 {
    let is i64 as v = cast(i64, src[p]) | (cast(i64, src[p + 1]) << 8)
                    | (cast(i64, src[p + 2]) << 16) | (cast(i64, src[p + 3]) << 24);
    return ((v * 2654435761) & 0xFFFFFFFF) >> 16;
}

fn _sn_lit(out as *bytes.Bytes, src as *u8, start as i64, length as i64) as void {
    if (length == 0) { return; }
    let is i64 as m = length - 1;
    if (m < 60) {
        bytes.bytes_push(out, cast(u8, m << 2));
    } else {
        let is i64 as nb with mut = 1;
        if (m >= 256) { nb = 2; }
        if (m >= 65536) { nb = 3; }
        if (m >= 16777216) { nb = 4; }
        bytes.bytes_push(out, cast(u8, (59 + nb) << 2));
        let is i64 as i with mut = 0;
        while (i < nb) { bytes.bytes_push(out, cast(u8, (m >> (8 * i)) & 0xFF)); i = i + 1; }
    }
    bytes.bytes_append(out, cast(*u8, cast(i64, src) + start), length);
}

fn _sn_copy(out as *bytes.Bytes, offset as i64, length as i64) as void {
    let is i64 as len with mut = length;
    while (len > 0) {
        if (len >= 4 && len <= 11 && offset < 2048) {
            bytes.bytes_push(out, cast(u8, ((offset >> 8) << 5) | ((len - 4) << 2) | 1));
            bytes.bytes_push(out, cast(u8, offset & 0xFF));
            len = 0;
        } else if (offset < 65536) {
            let is i64 as l with mut = len;
            if (l > 64) { l = 64; }
            bytes.bytes_push(out, cast(u8, ((l - 1) << 2) | 2));
            bytes.bytes_push(out, cast(u8, offset & 0xFF));
            bytes.bytes_push(out, cast(u8, (offset >> 8) & 0xFF));
            len = len - l;
        } else {
            let is i64 as l with mut = len;
            if (l > 64) { l = 64; }
            bytes.bytes_push(out, cast(u8, ((l - 1) << 2) | 3));
            bytes.bytes_push(out, cast(u8, offset & 0xFF));
            bytes.bytes_push(out, cast(u8, (offset >> 8) & 0xFF));
            bytes.bytes_push(out, cast(u8, (offset >> 16) & 0xFF));
            bytes.bytes_push(out, cast(u8, (offset >> 24) & 0xFF));
            len = len - l;
        }
    }
}

fn snappy_compress(src as *u8, src_len as i64, out as *bytes.Bytes, level as i64) as i64 {
    // varint preamble (uncompressed length)
    let is i64 as v with mut = src_len;
    while (1 == 1) {
        let is i64 as b = v & 0x7F;
        v = v >> 7;
        if (v != 0) { bytes.bytes_push(out, cast(u8, b | 0x80)); }
        else { bytes.bytes_push(out, cast(u8, b)); break; }
    }
    if (src_len == 0) { return out.len; }

    let is *i64 as head = cast(*i64, mem.core.mmap_anon(65536 * 8));
    mem.core.memset(cast(*u8, head), cast(i32, 0xFF), 65536 * 8);
    let is i64 as i with mut = 0;
    let is i64 as lit with mut = 0;
    while (i < src_len) {
        let is i64 as ml with mut = 0;
        let is i64 as mo with mut = 0;
        if (i + 4 <= src_len) {
            let is i64 as h = _sn_hash(src, i);
            let is i64 as cand = head[h];
            head[h] = i;
            if (cand >= 0) {
                if (src[cand] == src[i] && src[cand + 1] == src[i + 1]
                    && src[cand + 2] == src[i + 2] && src[cand + 3] == src[i + 3]) {
                    let is i64 as l with mut = 4;
                    while (i + l < src_len) {
                        if (src[cand + l] != src[i + l]) { break; }
                        l = l + 1;
                    }
                    ml = l; mo = i - cand;
                }
            }
        }
        if (ml >= 4) {
            _sn_lit(out, src, lit, i - lit);
            _sn_copy(out, mo, ml);
            i = i + ml;
            lit = i;
        } else {
            i = i + 1;
        }
    }
    _sn_lit(out, src, lit, src_len - lit);
    mem.core.munmap(cast(*u8, head), 65536 * 8);
    return out.len;
}


// ===================== Snappy framed stream (.sz) =======================
// Stream identifier + data chunks (compressed 0x00 / uncompressed 0x01) with
// masked CRC-32C checksums, per the Snappy framing spec. Chunk payload <= 64KB.

fn _sz_put24(out as *bytes.Bytes, v as i64) as void {
    bytes.bytes_push(out, cast(u8, v & 0xFF));
    bytes.bytes_push(out, cast(u8, (v >> 8) & 0xFF));
    bytes.bytes_push(out, cast(u8, (v >> 16) & 0xFF));
}
fn _sz_put32(out as *bytes.Bytes, v as i64) as void {
    bytes.bytes_push(out, cast(u8, v & 0xFF));
    bytes.bytes_push(out, cast(u8, (v >> 8) & 0xFF));
    bytes.bytes_push(out, cast(u8, (v >> 16) & 0xFF));
    bytes.bytes_push(out, cast(u8, (v >> 24) & 0xFF));
}

fn snappy_frame_compress(src as *u8, src_len as i64, out as *bytes.Bytes, level as i64) as i64 {
    // stream identifier chunk: 0xff, len=6, "sNaPpY"
    bytes.bytes_push(out, cast(u8, 0xFF)); _sz_put24(out, 6);
    bytes.bytes_push(out, cast(u8, 0x73)); bytes.bytes_push(out, cast(u8, 0x4E));
    bytes.bytes_push(out, cast(u8, 0x61)); bytes.bytes_push(out, cast(u8, 0x50));
    bytes.bytes_push(out, cast(u8, 0x70)); bytes.bytes_push(out, cast(u8, 0x59));

    let is i64 as pos with mut = 0;
    let is i64 as first with mut = 1;
    while (pos < src_len || first == 1) {
        first = 0;
        let is i64 as clen with mut = src_len - pos;
        if (clen > 65536) { clen = 65536; }
        if (clen == 0) { break; }
        let is *u8 as chunk = cast(*u8, cast(i64, src) + pos);
        let is i64 as crc = checksum.crc32c_masked(chunk, clen);
        let is bytes.Bytes as comp = bytes.bytes_new(256);
        snappy_compress(chunk, clen, &comp, level);
        if (comp.len < clen) {
            bytes.bytes_push(out, cast(u8, 0x00));            // compressed chunk
            _sz_put24(out, comp.len + 4);
            _sz_put32(out, crc);
            bytes.bytes_append(out, comp.ptr, comp.len);
        } else {
            bytes.bytes_push(out, cast(u8, 0x01));            // uncompressed chunk
            _sz_put24(out, clen + 4);
            _sz_put32(out, crc);
            bytes.bytes_append(out, chunk, clen);
        }
        bytes.bytes_free(&comp);
        pos = pos + clen;
    }
    return out.len;
}

fn snappy_frame_decompress(src as *u8, src_len as i64, out as *bytes.Bytes) as i64 {
    let is i64 as pos with mut = 0;
    while (pos < src_len) {
        if (pos + 4 > src_len) { return errno.Z_BADHDR; }
        let is i64 as ctype = cast(i64, src[pos]);
        let is i64 as clen = cast(i64, src[pos + 1]) | (cast(i64, src[pos + 2]) << 8) | (cast(i64, src[pos + 3]) << 16);
        let is i64 as body = pos + 4;
        if (body + clen > src_len) { return errno.Z_BADHDR; }
        if (ctype == 0xFF) {
            // stream identifier: verify "sNaPpY"
            if (clen != 6) { return errno.Z_BADHDR; }
            if (cast(i64, src[body]) != 0x73 || cast(i64, src[body + 1]) != 0x4E) { return errno.Z_BADHDR; }
        } else if (ctype == 0x00 || ctype == 0x01) {
            if (clen < 4) { return errno.Z_BADHDR; }
            let is i64 as wantCrc = _read32le_sz(src, body);
            // each framed chunk is self-contained: decode it into a fresh
            // buffer (so back-references are chunk-relative) then append.
            let is bytes.Bytes as chunk = bytes.bytes_new(256);
            if (ctype == 0x00) {
                if (snappy_decompress(cast(*u8, cast(i64, src) + body + 4), clen - 4, &chunk) < 0) {
                    bytes.bytes_free(&chunk); return errno.Z_BADHUFF;
                }
            } else {
                if (bytes.bytes_append(&chunk, cast(*u8, cast(i64, src) + body + 4), clen - 4) < 0) {
                    bytes.bytes_free(&chunk); return errno.Z_OOM;
                }
            }
            if (checksum.crc32c_masked(chunk.ptr, chunk.len) != wantCrc) { bytes.bytes_free(&chunk); return errno.Z_BADSUM; }
            if (bytes.bytes_append(out, chunk.ptr, chunk.len) < 0) { bytes.bytes_free(&chunk); return errno.Z_OOM; }
            bytes.bytes_free(&chunk);
        } else if (ctype >= 0x80 && ctype <= 0xFE) {
            // skippable / padding chunk: ignore
        } else {
            return errno.Z_BADTYPE;   // reserved unskippable
        }
        pos = body + clen;
    }
    return out.len;
}

fn _read32le_sz(p as *u8, off as i64) as i64 {
    return cast(i64, p[off]) | (cast(i64, p[off + 1]) << 8)
         | (cast(i64, p[off + 2]) << 16) | (cast(i64, p[off + 3]) << 24);
}
