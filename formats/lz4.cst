// =======================================================
// caustic-compact/formats/lz4.cst
// LZ4 decompression — frame format (magic 0x184D2204) wrapping LZ4 blocks.
// Block format: token (4-bit literal len + 4-bit match len-4), each length
// extensible via 0xFF bytes; 2-byte little-endian match offset; overlap-safe
// copy. Content checksum (xxHash32) is verified when present.
//   lz4_decompress(src, src_len, out) -> bytes written, or negative error.
// =======================================================

use "../core/errno.cst" as errno;
use "../core/bytes.cst" as bytes;
use "../core/checksum.cst" as checksum;
use "std/mem.cst" only bins, core as mem;

fn _le32(p as *u8, off as i64) as i64 {
    return cast(i64, p[off]) | (cast(i64, p[off + 1]) << 8)
         | (cast(i64, p[off + 2]) << 16) | (cast(i64, p[off + 3]) << 24);
}

// Decode one LZ4 block [off, off+blen) into out (appends).
fn _lz4_block(src as *u8, off as i64, blen as i64, out as *bytes.Bytes) as i64 {
    let is i64 as ip with mut = off;
    let is i64 as iend = off + blen;
    while (ip < iend) {
        let is i64 as token = cast(i64, src[ip]);
        ip = ip + 1;

        // literal length (high nibble, extensible)
        let is i64 as litlen with mut = token >> 4;
        if (litlen == 15) {
            while (ip < iend) {
                let is i64 as b = cast(i64, src[ip]);
                ip = ip + 1;
                litlen = litlen + b;
                if (b != 255) { break; }
            }
        }
        if (litlen > 0) {
            if (ip + litlen > iend) { return errno.Z_EOF; }
            if (bytes.bytes_append(out, cast(*u8, cast(i64, src) + ip), litlen) < 0) { return errno.Z_OOM; }
            ip = ip + litlen;
        }
        if (ip >= iend) { break; }                 // final sequence: literals only

        // match: 2-byte little-endian offset
        if (ip + 2 > iend) { return errno.Z_EOF; }
        let is i64 as offset = cast(i64, src[ip]) | (cast(i64, src[ip + 1]) << 8);
        ip = ip + 2;
        if (offset == 0) { return errno.Z_BADDIST; }

        // match length (low nibble + 4, extensible)
        let is i64 as matchlen with mut = (token & 0x0F) + 4;
        if ((token & 0x0F) == 15) {
            while (ip < iend) {
                let is i64 as b = cast(i64, src[ip]);
                ip = ip + 1;
                matchlen = matchlen + b;
                if (b != 255) { break; }
            }
        }

        // overlap-safe copy from `offset` bytes back in the output
        if (offset > out.len) { return errno.Z_BADDIST; }
        if (bytes.bytes_reserve(out, matchlen) < 0) { return errno.Z_OOM; }
        let is i64 as s with mut = out.len - offset;
        let is i64 as d with mut = out.len;
        let is i64 as e = out.len + matchlen;
        while (d < e) {
            out.ptr[d] = out.ptr[s];
            s = s + 1;
            d = d + 1;
        }
        out.len = e;
    }
    return 0;
}

fn lz4_decompress(src as *u8, src_len as i64, out as *bytes.Bytes) as i64 {
    if (src_len < 7) { return errno.Z_BADHDR; }
    if (_le32(src, 0) != 0x184D2204) { return errno.Z_BADHDR; }   // frame magic

    let is i64 as pos with mut = 4;
    let is i64 as flg = cast(i64, src[pos]); pos = pos + 1;
    pos = pos + 1;                                   // BD byte (max block size; unused here)
    if (((flg >> 6) & 3) != 1) { return errno.Z_BADHDR; }   // version must be 01

    let is i64 as block_checksum   = (flg >> 4) & 1;
    let is i64 as content_size     = (flg >> 3) & 1;
    let is i64 as content_checksum = (flg >> 2) & 1;
    let is i64 as dict_id          = flg & 1;

    if (content_size == 1) { pos = pos + 8; }
    if (dict_id == 1) { pos = pos + 4; }
    pos = pos + 1;                                   // header checksum byte (skip)

    while (pos + 4 <= src_len) {
        let is i64 as bsize = _le32(src, pos);
        pos = pos + 4;
        if (bsize == 0) { break; }                   // EndMark
        let is i64 as uncompressed = bsize & 0x80000000;
        let is i64 as realsize = bsize & 0x7FFFFFFF;
        if (pos + realsize > src_len) { return errno.Z_EOF; }
        if (uncompressed != 0) {
            if (bytes.bytes_append(out, cast(*u8, cast(i64, src) + pos), realsize) < 0) { return errno.Z_OOM; }
        } else {
            let is i64 as r = _lz4_block(src, pos, realsize, out);
            if (r < 0) { return r; }
        }
        pos = pos + realsize;
        if (block_checksum == 1) { pos = pos + 4; }
    }

    if (content_checksum == 1) {
        if (pos + 4 > src_len) { return errno.Z_EOF; }
        let is i64 as stored = _le32(src, pos);
        if (checksum.xxhash32(out.ptr, out.len) != stored) { return errno.Z_BADSUM; }
    }
    return out.len;
}

// ---- encode -----------------------------------------------------------
fn _wr_len(out as *bytes.Bytes, n as i64) as void {
    let is i64 as v with mut = n;
    while (v >= 255) { bytes.bytes_push(out, cast(u8, 255)); v = v - 255; }
    bytes.bytes_push(out, cast(u8, v));
}

fn _hash4(src as *u8, p as i64) as i64 {
    let is i64 as v = cast(i64, src[p]) | (cast(i64, src[p + 1]) << 8)
                    | (cast(i64, src[p + 2]) << 16) | (cast(i64, src[p + 3]) << 24);
    return ((v * 2654435761) & 0xFFFFFFFF) >> 16;
}

// Compress src[0,len) as one LZ4 block appended to out (greedy hash matcher).
// Longest 4+ byte match for position ip via the hash chain (offset <= 65535).
fn _lz4_best(src as *u8, ip as i64, matchlimit as i64, head as *i64, prev as *i64, distOut as *i64) as i64 {
    let is i64 as cand with mut = prev[ip];   // ip is already inserted; skip it
    let is i64 as bestLen with mut = 0;
    let is i64 as chain with mut = 0;
    while (cand >= 0) {
        if (ip - cand > 65535) { break; }
        if (chain >= 64) { break; }
        if (src[cand] == src[ip] && src[cand + 1] == src[ip + 1]
            && src[cand + 2] == src[ip + 2] && src[cand + 3] == src[ip + 3]) {
            let is i64 as l with mut = 4;
            while (ip + l < matchlimit) { if (src[cand + l] != src[ip + l]) { break; } l = l + 1; }
            if (l > bestLen) { bestLen = l; distOut[0] = ip - cand; }
        }
        cand = prev[cand];
        chain = chain + 1;
    }
    return bestLen;
}

fn _lz4_enc_block(src as *u8, len as i64, out as *bytes.Bytes) as i64 {
    let is *i64 as head = cast(*i64, mem.core.mmap_anon(65536 * 8));
    let is *i64 as prev = cast(*i64, mem.core.mmap_anon((len + 1) * 8));
    mem.core.memset(cast(*u8, head), cast(i32, 0xFF), 65536 * 8);   // -1
    let is i64 as anchor with mut = 0;
    let is i64 as ip with mut = 0;
    let is i64 as mflimit = len - 12;
    let is i64 as matchlimit = len - 5;

    if (len >= 13) {
        ip = 1;
        // insert position 0 so it can be referenced (prev[0] terminates its chain)
        prev[0] = 0 - 1;
        head[_hash4(src, 0)] = 0;
        while (ip < mflimit) {
            let is i64 as h0 = _hash4(src, ip);
            prev[ip] = head[h0]; head[h0] = ip;               // insert ip
            let is i64 as dist with mut = 0;
            let is i64 as mlen with mut = _lz4_best(src, ip, matchlimit, head, prev, &dist);
            if (mlen < 4) {
                ip = ip + 1;
            } else {
                // lazy: if ip+1 has a strictly longer match, defer (emit a literal)
                while (ip + 1 < mflimit) {
                    let is i64 as h1 = _hash4(src, ip + 1);
                    prev[ip + 1] = head[h1]; head[h1] = ip + 1;
                    let is i64 as d1 with mut = 0;
                    let is i64 as l1 = _lz4_best(src, ip + 1, matchlimit, head, prev, &d1);
                    if (l1 > mlen) { ip = ip + 1; mlen = l1; dist = d1; }
                    else { break; }
                }
                let is i64 as cand = ip - dist;
                let is i64 as litLen = ip - anchor;
                let is i64 as mcode = mlen - 4;
                let is i64 as t1 with mut = litLen;
                if (t1 > 15) { t1 = 15; }
                let is i64 as t2 with mut = mcode;
                if (t2 > 15) { t2 = 15; }
                bytes.bytes_push(out, cast(u8, (t1 << 4) | t2));
                if (litLen >= 15) { _wr_len(out, litLen - 15); }
                bytes.bytes_append(out, cast(*u8, cast(i64, src) + anchor), litLen);
                let is i64 as offset = dist;
                bytes.bytes_push(out, cast(u8, offset & 0xFF));
                bytes.bytes_push(out, cast(u8, (offset >> 8) & 0xFF));
                if (mcode >= 15) { _wr_len(out, mcode - 15); }
                // insert the match span positions
                let is i64 as k with mut = ip + 1;
                while (k < ip + mlen && k < mflimit) {
                    let is i64 as hk = _hash4(src, k);
                    prev[k] = head[hk]; head[hk] = k;
                    k = k + 1;
                }
                ip = ip + mlen;
                anchor = ip;
            }
        }
    }
    // last literals
    let is i64 as litLen = len - anchor;
    let is i64 as t with mut = litLen;
    if (t > 15) { t = 15; }
    bytes.bytes_push(out, cast(u8, t << 4));
    if (litLen >= 15) { _wr_len(out, litLen - 15); }
    bytes.bytes_append(out, cast(*u8, cast(i64, src) + anchor), litLen);
    mem.core.munmap(cast(*u8, head), 65536 * 8);
    mem.core.munmap(cast(*u8, prev), (len + 1) * 8);
    return 0;
}

// Compress into an LZ4 frame (magic 04 22 4D 18, 4 MB blocks, no checksums).
fn lz4_compress(src as *u8, src_len as i64, out as *bytes.Bytes, level as i64) as i64 {
    bytes.bytes_push(out, cast(u8, 0x04));
    bytes.bytes_push(out, cast(u8, 0x22));
    bytes.bytes_push(out, cast(u8, 0x4D));
    bytes.bytes_push(out, cast(u8, 0x18));
    let is [2]u8 as desc;
    desc[0] = cast(u8, 0x60);   // FLG: version 01, block-independence
    desc[1] = cast(u8, 0x70);   // BD: 4 MB max block size
    bytes.bytes_push(out, desc[0]);
    bytes.bytes_push(out, desc[1]);
    let is i64 as hc = (checksum.xxhash32(cast(*u8, &desc), 2) >> 8) & 0xFF;
    bytes.bytes_push(out, cast(u8, hc));

    let is i64 as pos with mut = 0;
    while (pos < src_len) {
        let is i64 as chunk with mut = src_len - pos;
        if (chunk > 4194304) { chunk = 4194304; }
        let is bytes.Bytes as blk = bytes.bytes_new(256);
        if (_lz4_enc_block(cast(*u8, cast(i64, src) + pos), chunk, &blk) < 0) { bytes.bytes_free(&blk); return errno.Z_OOM; }
        if (blk.len >= chunk) {
            // store uncompressed (high bit set)
            let is i64 as bs = chunk | 0x80000000;
            bytes.bytes_push(out, cast(u8, bs & 0xFF));
            bytes.bytes_push(out, cast(u8, (bs >> 8) & 0xFF));
            bytes.bytes_push(out, cast(u8, (bs >> 16) & 0xFF));
            bytes.bytes_push(out, cast(u8, (bs >> 24) & 0xFF));
            bytes.bytes_append(out, cast(*u8, cast(i64, src) + pos), chunk);
        } else {
            bytes.bytes_push(out, cast(u8, blk.len & 0xFF));
            bytes.bytes_push(out, cast(u8, (blk.len >> 8) & 0xFF));
            bytes.bytes_push(out, cast(u8, (blk.len >> 16) & 0xFF));
            bytes.bytes_push(out, cast(u8, (blk.len >> 24) & 0xFF));
            bytes.bytes_append(out, blk.ptr, blk.len);
        }
        bytes.bytes_free(&blk);
        pos = pos + chunk;
    }
    bytes.bytes_push(out, cast(u8, 0)); bytes.bytes_push(out, cast(u8, 0));
    bytes.bytes_push(out, cast(u8, 0)); bytes.bytes_push(out, cast(u8, 0));   // EndMark
    return out.len;
}
