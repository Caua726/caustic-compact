// =======================================================
// caustic-compact/formats/lzw.cst
// Variable-width LZW as used by GIF (LSB-first bit packing, per-stream clear
// and end codes). The caller de-blocks the GIF sub-blocks into one contiguous
// buffer and passes the LZW "minimum code size"; decode emits palette indices
// into `out`. TIFF's MSB-first / early-change variant will be a sibling later.
//   lzw_gif_decode(src, src_len, min_code_size, out) -> 0, or negative errno.
// =======================================================

use "../core/errno.cst"     as errno;
use "../core/bytes.cst"     as bytes;
use "../core/bitreader.cst" as bitreader;
use "std/mem.cst" only bins, core as mem;

let is i64 as _LZW_MAX with imut = 4096;

// Reconstruct the string for `code` (walking the prefix chain) and append it
// to `out`, most-significant char first. Returns 0, or negative on OOM/overrun.
fn _emit(out as *bytes.Bytes, code as i64, clear as i64,
         prefix as *i64, suffix as *i64, stack as *i64) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as k with mut = code;
    while (k >= clear) {
        if (n >= _LZW_MAX) { return errno.Z_BADHUFF; }   // corrupt chain
        stack[n] = suffix[k];
        n = n + 1;
        k = prefix[k];
    }
    stack[n] = k;
    n = n + 1;
    while (n > 0) {
        n = n - 1;
        if (bytes.bytes_push(out, cast(u8, stack[n] & 255)) < 0) { return errno.Z_OOM; }
    }
    return 0;
}

fn lzw_gif_decode(src as *u8, src_len as i64, min_code_size as i64,
                  out as *bytes.Bytes) as i64 {
    if (min_code_size < 1) { return errno.Z_BADHDR; }
    if (min_code_size > 11) { return errno.Z_BADHDR; }

    let is i64 as clear = 1 << min_code_size;
    let is i64 as end = clear + 1;

    let is *i64 as prefix = cast(*i64, mem.core.mmap_anon(_LZW_MAX * 8));
    let is *i64 as suffix = cast(*i64, mem.core.mmap_anon(_LZW_MAX * 8));
    let is *i64 as firstb = cast(*i64, mem.core.mmap_anon(_LZW_MAX * 8));
    let is *i64 as stack  = cast(*i64, mem.core.mmap_anon(_LZW_MAX * 8));
    if (cast(i64, stack) <= 0) { return errno.Z_OOM; }

    let is i64 as i with mut = 0;
    while (i < clear) { firstb[i] = i; i = i + 1; }

    let is i64 as code_size with mut = min_code_size + 1;
    let is i64 as next_code with mut = clear + 2;
    let is i64 as prev with mut = 0 - 1;
    let is i64 as rc with mut = 0;

    let is bitreader.BitReader as br;
    bitreader.br_init(&br, src, src_len);

    let is i64 as go with mut = 1;
    while (go == 1) {
        let is i64 as code = bitreader.br_get(&br, code_size);
        if (code < 0) { go = 0; }
        else {
            if (code == clear) {
                code_size = min_code_size + 1;
                next_code = clear + 2;
                prev = 0 - 1;
            } else {
                if (code == end) { go = 0; }
                else {
                    if (prev < 0) {
                        // first code after a clear must be a literal root
                        if (code >= clear) { rc = errno.Z_BADHUFF; go = 0; }
                        else {
                            if (bytes.bytes_push(out, cast(u8, code)) < 0) { rc = errno.Z_OOM; go = 0; }
                            prev = code;
                        }
                    } else {
                        let is i64 as add_byte with mut = 0;
                        if (code < next_code) {
                            if (_emit(out, code, clear, prefix, suffix, stack) < 0) { rc = errno.Z_OOM; go = 0; }
                            add_byte = firstb[code];
                        } else {
                            if (code != next_code) { rc = errno.Z_BADHUFF; go = 0; }
                            else {
                                if (_emit(out, prev, clear, prefix, suffix, stack) < 0) { rc = errno.Z_OOM; go = 0; }
                                if (bytes.bytes_push(out, cast(u8, firstb[prev] & 255)) < 0) { rc = errno.Z_OOM; go = 0; }
                                add_byte = firstb[prev];
                            }
                        }
                        if (go == 1) {
                            if (next_code < _LZW_MAX) {
                                prefix[next_code] = prev;
                                suffix[next_code] = add_byte;
                                firstb[next_code] = firstb[prev];
                                next_code = next_code + 1;
                                if (next_code == (1 << code_size)) {
                                    if (code_size < 12) { code_size = code_size + 1; }
                                }
                            }
                            prev = code;
                        }
                    }
                }
            }
        }
    }

    mem.core.munmap(cast(*u8, prefix), _LZW_MAX * 8);
    mem.core.munmap(cast(*u8, suffix), _LZW_MAX * 8);
    mem.core.munmap(cast(*u8, firstb), _LZW_MAX * 8);
    mem.core.munmap(cast(*u8, stack),  _LZW_MAX * 8);
    return rc;
}
