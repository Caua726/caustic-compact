// =======================================================
// caustic-compact/formats/lzw.cst
// Variable-width LZW as used by GIF (LSB-first bit packing, per-stream clear
// and end codes). The caller de-blocks the GIF sub-blocks into one contiguous
// buffer and passes the LZW "minimum code size"; decode emits palette indices
// into `out`. TIFF's MSB-first / early-change variant will be a sibling later.
//   lzw_gif_decode(src, src_len, min_code_size, out) -> 0, or negative errno.
// =======================================================

use "../core/errno.cst"     as errno;
use "../core/bytes.cst"     as bytes;
use "../core/bitreader.cst" as bitreader;
use "std/mem.cst" only bins, core as mem;

let is i64 as _LZW_MAX with imut = 4096;

// Reconstruct the string for `code` (walking the prefix chain) and append it
// to `out`, most-significant char first. Returns 0, or negative on OOM/overrun.
fn _emit(out as *bytes.Bytes, code as i64, clear as i64,
         prefix as *i64, suffix as *i64, stack as *i64) as i64 {
    let is i64 as n with mut = 0;
    let is i64 as k with mut = code;
    while (k >= clear) {
        if (n >= _LZW_MAX) { return errno.Z_BADHUFF; }   // corrupt chain
        stack[n] = suffix[k];
        n = n + 1;
        k = prefix[k];
    }
    stack[n] = k;
    n = n + 1;
    while (n > 0) {
        n = n - 1;
        if (bytes.bytes_push(out, cast(u8, stack[n] & 255)) < 0) { return errno.Z_OOM; }
    }
    return 0;
}

fn lzw_gif_decode(src as *u8, src_len as i64, min_code_size as i64,
                  out as *bytes.Bytes) as i64 {
    if (min_code_size < 1) { return errno.Z_BADHDR; }
    if (min_code_size > 11) { return errno.Z_BADHDR; }

    let is i64 as clear = 1 << min_code_size;
    let is i64 as end = clear + 1;

    let is *i64 as prefix = cast(*i64, mem.core.mmap_anon(_LZW_MAX * 8));
    let is *i64 as suffix = cast(*i64, mem.core.mmap_anon(_LZW_MAX * 8));
    let is *i64 as firstb = cast(*i64, mem.core.mmap_anon(_LZW_MAX * 8));
    let is *i64 as stack  = cast(*i64, mem.core.mmap_anon(_LZW_MAX * 8));
    if (cast(i64, stack) <= 0) { return errno.Z_OOM; }

    let is i64 as i with mut = 0;
    while (i < clear) { firstb[i] = i; i = i + 1; }

    let is i64 as code_size with mut = min_code_size + 1;
    let is i64 as next_code with mut = clear + 2;
    let is i64 as prev with mut = 0 - 1;
    let is i64 as rc with mut = 0;

    let is bitreader.BitReader as br;
    bitreader.br_init(&br, src, src_len);

    let is i64 as go with mut = 1;
    while (go == 1) {
        let is i64 as code = bitreader.br_get(&br, code_size);
        if (code < 0) { go = 0; }
        else {
            if (code == clear) {
                code_size = min_code_size + 1;
                next_code = clear + 2;
                prev = 0 - 1;
            } else {
                if (code == end) { go = 0; }
                else {
                    if (prev < 0) {
                        // first code after a clear must be a literal root
                        if (code >= clear) { rc = errno.Z_BADHUFF; go = 0; }
                        else {
                            if (bytes.bytes_push(out, cast(u8, code)) < 0) { rc = errno.Z_OOM; go = 0; }
                            prev = code;
                        }
                    } else {
                        let is i64 as add_byte with mut = 0;
                        if (code < next_code) {
                            if (_emit(out, code, clear, prefix, suffix, stack) < 0) { rc = errno.Z_OOM; go = 0; }
                            add_byte = firstb[code];
                        } else {
                            if (code != next_code) { rc = errno.Z_BADHUFF; go = 0; }
                            else {
                                if (_emit(out, prev, clear, prefix, suffix, stack) < 0) { rc = errno.Z_OOM; go = 0; }
                                if (bytes.bytes_push(out, cast(u8, firstb[prev] & 255)) < 0) { rc = errno.Z_OOM; go = 0; }
                                add_byte = firstb[prev];
                            }
                        }
                        if (go == 1) {
                            if (next_code < _LZW_MAX) {
                                prefix[next_code] = prev;
                                suffix[next_code] = add_byte;
                                firstb[next_code] = firstb[prev];
                                next_code = next_code + 1;
                                if (next_code == (1 << code_size)) {
                                    if (code_size < 12) { code_size = code_size + 1; }
                                }
                            }
                            prev = code;
                        }
                    }
                }
            }
        }
    }

    mem.core.munmap(cast(*u8, prefix), _LZW_MAX * 8);
    mem.core.munmap(cast(*u8, suffix), _LZW_MAX * 8);
    mem.core.munmap(cast(*u8, firstb), _LZW_MAX * 8);
    mem.core.munmap(cast(*u8, stack),  _LZW_MAX * 8);
    return rc;
}

// ---- TIFF-flavour LZW (MSB-first codes, "early change") -------------------
// TIFF packs codes most-significant-bit first and widens the code one step
// EARLIER than GIF (when next_code == (1<<width)-1). Fixed alphabet: 256
// literals, 256=Clear, 257=EOI, dynamic codes from 258.
fn lzw_tiff_decode(src as *u8, src_len as i64, out as *bytes.Bytes) as i64 {
    let is *i64 as prefix = cast(*i64, mem.core.mmap_anon(_LZW_MAX * 8));
    let is *i64 as suffix = cast(*i64, mem.core.mmap_anon(_LZW_MAX * 8));
    let is *i64 as firstb = cast(*i64, mem.core.mmap_anon(_LZW_MAX * 8));
    let is *i64 as stack  = cast(*i64, mem.core.mmap_anon(_LZW_MAX * 8));
    if (cast(i64, stack) <= 0) { return errno.Z_OOM; }
    let is i64 as i with mut = 0;
    while (i < 256) { firstb[i] = i; i = i + 1; }

    // MSB-first bit reader state.
    let is i64 as pos with mut = 0;
    let is i64 as acc with mut = 0;
    let is i64 as nbits with mut = 0;

    let is i64 as width with mut = 9;
    let is i64 as next_code with mut = 258;
    let is i64 as prev with mut = 0 - 1;
    let is i64 as rc with mut = 0;
    let is i64 as go with mut = 1;
    while (go == 1) {
        while (nbits < width) {
            if (pos >= src_len) { go = 0; nbits = width; acc = acc << (width - nbits); }
            else { acc = (acc << 8) | cast(i64, src[pos]); pos = pos + 1; nbits = nbits + 8; }
        }
        if (go == 1) {
            let is i64 as code = (acc >> (nbits - width)) & ((1 << width) - 1);
            nbits = nbits - width;
            if (code == 257) { go = 0; }                    // EOI
            else {
                if (code == 256) {                          // Clear
                    width = 9; next_code = 258; prev = 0 - 1;
                } else {
                    if (prev < 0) {
                        if (code >= 256) { rc = errno.Z_BADHUFF; go = 0; }
                        else { bytes.bytes_push(out, cast(u8, code)); prev = code; }
                    } else {
                        let is i64 as add_byte with mut = 0;
                        if (code < next_code) {
                            if (_emit(out, code, 256, prefix, suffix, stack) < 0) { rc = errno.Z_OOM; go = 0; }
                            add_byte = firstb[code];
                        } else {
                            if (code != next_code) { rc = errno.Z_BADHUFF; go = 0; }
                            else {
                                if (_emit(out, prev, 256, prefix, suffix, stack) < 0) { rc = errno.Z_OOM; go = 0; }
                                if (go == 1) { bytes.bytes_push(out, cast(u8, firstb[prev] & 255)); }
                                add_byte = firstb[prev];
                            }
                        }
                        if (go == 1) {
                            if (next_code < _LZW_MAX) {
                                prefix[next_code] = prev;
                                suffix[next_code] = add_byte;
                                firstb[next_code] = firstb[prev];
                                next_code = next_code + 1;
                                // early change: widen one code sooner than GIF.
                                if (next_code == (1 << width) - 1) {
                                    if (width < 12) { width = width + 1; }
                                }
                            }
                            prev = code;
                        }
                    }
                }
            }
        }
    }
    mem.core.munmap(cast(*u8, prefix), _LZW_MAX * 8);
    mem.core.munmap(cast(*u8, suffix), _LZW_MAX * 8);
    mem.core.munmap(cast(*u8, firstb), _LZW_MAX * 8);
    mem.core.munmap(cast(*u8, stack),  _LZW_MAX * 8);
    return rc;
}

// Append one variable-width code (LSB-first) to `out`. st = [bitbuf, nbits].
fn _emit_code(out as *bytes.Bytes, code as i64, code_size as i64, st as *i64) as void {
    let is i64 as bitbuf with mut = st[0] | (code << st[1]);
    let is i64 as nbits with mut = st[1] + code_size;
    while (nbits >= 8) {
        bytes.bytes_push(out, cast(u8, bitbuf & 255));
        bitbuf = bitbuf >> 8;
        nbits = nbits - 8;
    }
    st[0] = bitbuf;
    st[1] = nbits;
}

// GIF-flavour LZW encode: `indices` are palette indices (each < 1<<mcs). The
// raw LZW byte stream is appended to `out` (the caller does GIF sub-blocking).
// Dictionary growth mirrors lzw_gif_decode so our own decoder — and giflib —
// read it back. Returns 0, or a negative errno.
fn lzw_gif_encode(indices as *u8, n as i64, min_code_size as i64,
                  out as *bytes.Bytes) as i64 {
    if (min_code_size < 1) { return errno.Z_BADHDR; }
    if (min_code_size > 11) { return errno.Z_BADHDR; }
    let is i64 as clear = 1 << min_code_size;
    let is i64 as end = clear + 1;

    // Direct-mapped dictionary: key (prefix_code<<8)|byte -> code, -1 = empty.
    let is i64 as DSIZE = 4096 * 256;
    let is *i32 as dict = cast(*i32, mem.core.mmap_anon(DSIZE * 4));
    if (cast(i64, dict) <= 0) { return errno.Z_OOM; }
    mem.core.memset(cast(*u8, dict), cast(i32, 255), DSIZE * 4);   // all -1

    let is [2]i64 as st;
    let is *i64 as stp = cast(*i64, &st);
    st[0] = 0;
    st[1] = 0;

    let is i64 as code_size with mut = min_code_size + 1;
    let is i64 as next_code with mut = clear + 2;
    _emit_code(out, clear, code_size, stp);

    if (n > 0) {
        let is i64 as w with mut = cast(i64, indices[0]);
        let is i64 as i with mut = 1;
        while (i < n) {
            let is i64 as k = cast(i64, indices[i]);
            let is i64 as key = (w << 8) | k;
            let is i64 as found = cast(i64, dict[key]);
            if (found >= 0) {
                w = found;
            } else {
                _emit_code(out, w, code_size, stp);
                if (next_code < 4096) {
                    dict[key] = cast(i32, next_code);
                    next_code = next_code + 1;
                    // The decoder builds its table one entry behind us, so we
                    // widen one code later than a naive "==": bump when the new
                    // next_code no longer fits the current width.
                    if (next_code > (1 << code_size)) {
                        if (code_size < 12) { code_size = code_size + 1; }
                    }
                } else {
                    _emit_code(out, clear, code_size, stp);
                    mem.core.memset(cast(*u8, dict), cast(i32, 255), DSIZE * 4);
                    code_size = min_code_size + 1;
                    next_code = clear + 2;
                }
                w = k;
            }
            i = i + 1;
        }
        _emit_code(out, w, code_size, stp);
    }
    _emit_code(out, end, code_size, stp);
    if (st[1] > 0) { bytes.bytes_push(out, cast(u8, st[0] & 255)); }

    mem.core.munmap(cast(*u8, dict), DSIZE * 4);
    return 0;
}
