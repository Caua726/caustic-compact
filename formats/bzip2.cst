// =======================================================
// caustic-compact/formats/bzip2.cst
// bzip2 decompression. Pipeline per block: MSB-first bit reader -> symbol
// map -> group selectors (MTF) -> per-group canonical Huffman tables ->
// MTF + RUNA/RUNB run-length decode -> inverse Burrows-Wheeler transform ->
// RLE1 decode. Checks are not verified (decode only).
//   bzip2_decompress(src, src_len, out) -> bytes written, or negative error.
// =======================================================

use "../core/errno.cst" as errno;
use "../core/bytes.cst" as bytes;
use "std/mem.cst" only bins, core as mem;

// MSB-first bit reader (bzip2 packs bits most-significant first).
struct BzBits {
    src as *u8; len as i64; pos as i64; buf as i64; n as i64;
}

fn _bit(b as *BzBits) as i64 {
    if (b.n == 0) {
        if (b.pos >= b.len) { return 0; }
        b.buf = cast(i64, b.src[b.pos]);
        b.pos = b.pos + 1;
        b.n = 8;
    }
    b.n = b.n - 1;
    return (b.buf >> b.n) & 1;
}

fn _bits(b as *BzBits, count as i64) as i64 {
    let is i64 as v with mut = 0;
    let is i64 as i with mut = 0;
    while (i < count) {
        v = (v << 1) | _bit(b);
        i = i + 1;
    }
    return v;
}

fn _i64arr(n as i64) as *i64 { return cast(*i64, mem.core.mmap_anon(n * 8)); }

let is *u8 as _RN with imut = "\x6b\x02\xd0\x02\x7f\x00\xe1\x01\xa3\x03\x30\x03\x2d\x03\xe9\x00\x36\x02\xf7\x00\xd9\x03\xd4\x02\xcd\x00\xc6\x01\x5f\x03\xeb\x01\xe5\x02\xf2\x00\xb5\x03\xd6\x00\xdd\x02\x5b\x03\x4f\x01\xc4\x02\x6d\x02\x3e\x02\x49\x00\x8e\x02\xda\x02\xd8\x01\xa3\x01\xb4\x01\x16\x01\xf0\x01\x63\x03\xd2\x00\x8f\x01\xa8\x02\xe0\x01\x33\x00\x6e\x03\xd1\x01\x2b\x03\xa9\x00\x65\x03\xa3\x02\x63\x02\xb9\x02\x63\x03\x31\x02\x5e\x03\xaf\x02\xfb\x01\x1b\x01\xe2\x01\x81\x00\x27\x03\x4f\x02\xdd\x02\x6f\x02\x96\x00\xee\x00\x3b\x00\x7b\x01\xac\x02\x6d\x03\x71\x02\xa9\x00\x83\x02\x69\x00\xaa\x00\x5f\x02\x08\x02\xa4\x03\xd7\x02\xdc\x01\xb5\x02\xa9\x01\xae\x00\x87\x02\x49\x00\x7a\x00\x4f\x01\x12\x02\xba\x01\x55\x03\xb7\x02\xf9\x00\xbd\x01\x03\x02\x8d\x03\x21\x02\xbf\x02\x97\x03\x6a\x03\xda\x01\x72\x03\xf4\x01\x52\x02\x64\x02\x81\x02\x21\x03\xdc\x00\xa2\x00\x33\x03\xd8\x03\x4d\x02\x01\x02\xef\x01\x1f\x03\xa1\x00\x5c\x02\xbe\x03\x15\x02\xdd\x00\x90\x01\x82\x01\x63\x03\x58\x02\x0e\x03\x7e\x01\x54\x02\x9e\x01\xab\x00\x04\x02\x77\x01\xaa\x02\xe5\x01\x8f\x03\x14\x01\x62\x00\x29\x02\xa3\x00\x62\x01\x9a\x02\xa5\x03\xa8\x01\x55\x01\x15\x02\x66\x03\xe3\x00\xda\x02\xdb\x01\xba\x00\x07\x01\x87\x02\x19\x02\xae\x02\x58\x02\xe0\x00\xd5\x01\x44\x00\x02\x03\x97\x03\xbe\x00\x75\x01\x26\x01\x36\x03\x28\x03\xce\x00\xb8\x00\xaf\x03\x1b\x03\x80\x01\x7f\x01\xcd\x01\x94\x01\xf6\x02\x47\x03\x77\x03\xcb\x02\x43\x00\x6a\x02\x14\x01\xcc\x00\x96\x03\x69\x03\x09\x03\x5c\x02\x30\x02\xb7\x03\xa0\x00\x42\x02\xd2\x02\x4f\x00\x24\x03\x60\x00\x99\x01\xc9\x02\xac\x03\x8c\x02\xa6\x03\xca\x03\xbf\x01\x3e\x01\x61\x01\x5b\x03\xa0\x02\x70\x00\x11\x03\x85\x02\x5f\x03\x23\x03\x5e\x01\x8b\x00\x5d\x00\x62\x01\x63\x00\x34\x03\x8c\x03\x61\x02\x04\x03\x9a\x00\x12\x01\x44\x02\xb8\x00\x4f\x00\x72\x02\x76\x02\xe6\x02\x8d\x02\x1a\x01\xfa\x02\x6f\x02\xa8\x02\x51\x00\x9f\x03\x72\x02\x15\x03\x7d\x00\x9b\x01\x09\x02\xaa\x03\x2c\x01\x35\x03\x4e\x00\x57\x01\xaf\x00\x80\x00\xfa\x00\xaa\x00\x06\x03\xcc\x03\x13\x01\xe7\x03\x7f\x02\xef\x01\x4e\x00\x60\x01\x7e\x00\x59\x03\xbc\x03\x66\x01\x6b\x02\x44\x02\x7c\x00\xe1\x02\x52\x02\xbd\x02\x64\x02\x9d\x02\x70\x00\x86\x00\xb6\x02\x6b\x01\xe0\x03\x29\x03\xe7\x02\xa8\x00\xce\x03\xb0\x03\x77\x01\xec\x02\x34\x00\x58\x02\xeb\x02\x82\x02\xb6\x00\x5e\x03\x51\x00\x58\x01\x25\x03\xdc\x03\xe3\x02\xff\x01\x8f\x02\x2e\x03\x4e\x01\xf9\x00\x03\x02\x81\x03\xbb\x03\x98\x02\xd5\x03\x89\x02\x71\x00\xce\x03\xcb\x01\x7d\x03\xe4\x00\xb1\x01\x45\x03\x29\x02\x0c\x01\x9e\x03\xf0\x00\x66\x00\x8e\x02\xcb\x01\x33\x00\xae\x02\xf2\x02\x26\x03\xf8\x02\xed\x01\x93\x01\x9f\x01\x8a\x01\xaf\x02\xbc\x02\xb2\x03\x9e\x02\x90\x02\x62\x02\xe2\x02\x88\x01\xf8\x02\x1f\x03\x77\x03\x8d\x02\xd2\x03\x41\x01\x40\x02\x69\x02\x72\x02\xf6\x01\x7e\x03\xa7\x02\xf3\x00\xb8\x01\xa8\x02\x6f\x03\xc2\x00\x3c\x02\x80\x02\xd4\x02\x9e\x03\x38\x00\xcc\x00\xbc\x02\xc3\x02\x97\x00\xc9\x01\xc1\x01\x1d\x03\xc3\x00\x17\x03\x2e\x02\xb1\x03\xa7\x02\x29\x01\x3b\x00\x57\x00\x38\x03\xc9\x02\x97\x02\x9c\x01\xb5\x02\x56\x01\x5e\x02\x86\x00\x6c\x00\x3b\x02\x6c\x01\x77\x02\xd4\x00\xae\x00\x83\x02\x30\x01\x49\x01\x57\x01\x61\x00\xae\x01\xef\x02\xf1\x01\x3a\x01\xd7\x03\x76\x01\x36\x03\xa0\x03\x8c\x00\xce\x00\x49\x00\x07\x01\xd4\x03\xe0\x02\x6c\x03\xde\x01\xae\x01\x31\x01\xaa\x00\x02\x02\x6c\x01\xb4\x02\x3d\x03\x52\x00\x57\x03\xb9\x03\xa4\x02\xf6\x00\x71\x01\xca\x03\x26\x01\xee\x02\x27\x03\x3b\x03\x96\x00\x16\x03\x20\x01\x9b\x03\x24\x03\x7a\x01\xd7\x00\x3c\x03\x50\x02\x19\x01\x35\x02\x2b\x02\xc6\x02\x52\x00\x80\x03\x3f\x03\x23\x02\x05\x01\x0c\x02\xce\x01\x25\x01\xd1\x01\xf6\x01\x38\x00\x95\x02\x35\x03\xd0\x03\xdf\x03\x92\x02\x65\x03\x89\x03\xf6\x02\xe9\x02\xc1\x00\x00\x03\x26\x02\x60\x02\xa5\x03\x7a\x01\x1e\x01\xd7\x00\xd3\x03\x18\x03\xc1\x03\x3d\x00\xb0\x02\x19\x03\x84\x02\xda\x03\x93\x01\x6a\x00\x6e\x01\x89\x03\x84\x02\x74\x01\x37\x02\xd2\x01\xb2\x01\x85\x02\xd2\x00\x85\x01\x26\x02\x97\x03\x87\x00\x0c\x03\x05\x03\x7b\x02\x85\x01\xc3\x02\x64\x00\x72\x02\xbe\x03\xa5\x00\xf8\x01\x98\x03\xb0\x00\xc1\x00\xc9\x02\x59\x03\x09\x01\xcb\x00\x32\x00\x9c\x02\x6c\x00\x85\x02\xde\x03\x72\x02\xc5\x00\xfe\x01\x65\x01\x66\x01\x52\x03\x5a\x03\x6c\x01\xa8\x03\x7e\x02";
fn _rnum(i as i64) as i64 {
    return cast(i64, _RN[i * 2]) | (cast(i64, _RN[i * 2 + 1]) << 8);
}


// Decode one bzip2 stream into `out`. Assumes the 4-byte "BZhN" header.
fn bzip2_decompress(src as *u8, src_len as i64, out as *bytes.Bytes) as i64 {
    if (src_len < 4) { return errno.Z_BADHDR; }
    if (cast(i64, src[0]) != 0x42) { return errno.Z_BADHDR; }   // 'B'
    if (cast(i64, src[1]) != 0x5A) { return errno.Z_BADHDR; }   // 'Z'
    if (cast(i64, src[2]) != 0x68) { return errno.Z_BADHDR; }   // 'h'
    let is i64 as level = cast(i64, src[3]) - 48;
    if (level < 1) { return errno.Z_BADHDR; }
    if (level > 9) { return errno.Z_BADHDR; }
    let is i64 as maxBlock = level * 100000 + 10;

    let is BzBits as b;
    b.src = src; b.len = src_len; b.pos = 4; b.buf = 0; b.n = 0;

    // per-stream scratch (reused across blocks)
    let is *i64 as lens   = _i64arr(6 * 258);
    let is *i64 as perm   = _i64arr(6 * 258);
    let is *i64 as limit  = _i64arr(6 * 25);
    let is *i64 as base   = _i64arr(6 * 25);
    let is *i64 as minLens = _i64arr(6);
    let is *i64 as selectors = _i64arr(32768);
    let is *i64 as bwt = _i64arr(maxBlock);
    let is *i64 as tt  = _i64arr(maxBlock);
    if (cast(i64, tt) <= 0) { return errno.Z_OOM; }

    let is [256]i64 as symMap;
    let is [256]i64 as mtf;
    let is [256]i64 as unzftab;
    let is [257]i64 as cftab;
    let is [6]i64 as gmtf;

    let is i64 as combinedCrc with mut = 0;
    while (1 == 1) {
        // 48-bit block magic
        let is i64 as hi = _bits(&b, 24);
        let is i64 as lo = _bits(&b, 24);
        if (hi == 0x177245) {                  // stream end (.387245385090)
            let is i64 as expCrc = (_bits(&b, 16) << 16) | _bits(&b, 16);
            if (combinedCrc != expCrc) { return errno.Z_BADSUM; }
            return out.len;
        }
        if (hi != 0x314159) { return errno.Z_BADHDR; }
        if (lo != 0x265359) { return errno.Z_BADHDR; }

        let is i64 as blockOutStart = out.len;
        let is i64 as junk1 = _bits(&b, 32);   // block CRC (verified per block below)
        let is i64 as randomized = _bit(&b);           // deprecated randomization
        let is i64 as origPtr = _bits(&b, 24);

        // symbol map: 16-bit group mask + 16 bits per used group
        let is i64 as used16 = _bits(&b, 16);
        let is i64 as nInUse with mut = 0;
        let is i64 as i with mut = 0;
        while (i < 16) {
            if (((used16 >> (15 - i)) & 1) == 1) {
                let is i64 as bits16 = _bits(&b, 16);
                let is i64 as j with mut = 0;
                while (j < 16) {
                    if (((bits16 >> (15 - j)) & 1) == 1) {
                        symMap[nInUse] = i * 16 + j;
                        nInUse = nInUse + 1;
                    }
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        let is i64 as alphaSize = nInUse + 2;
        let is i64 as EOB = nInUse + 1;

        let is i64 as nGroups = _bits(&b, 3);
        let is i64 as nSelectors = _bits(&b, 15);

        // selectors: unary-coded MTF indices over group numbers
        i = 0;
        while (i < nGroups) { gmtf[i] = i; i = i + 1; }
        let is i64 as s with mut = 0;
        while (s < nSelectors) {
            let is i64 as jj with mut = 0;
            while (_bit(&b) == 1) { jj = jj + 1; }
            let is i64 as v = gmtf[jj];
            let is i64 as k with mut = jj;
            while (k > 0) { gmtf[k] = gmtf[k - 1]; k = k - 1; }
            gmtf[0] = v;
            selectors[s] = v;
            s = s + 1;
        }

        // per-group code lengths (delta-coded) and decode tables
        let is i64 as g with mut = 0;
        while (g < nGroups) {
            let is i64 as curr with mut = _bits(&b, 5);
            let is i64 as si with mut = 0;
            while (si < alphaSize) {
                while (_bit(&b) == 1) {
                    if (_bit(&b) == 0) { curr = curr + 1; } else { curr = curr - 1; }
                }
                lens[g * 258 + si] = curr;
                si = si + 1;
            }
            // build limit/base/perm (BZ2_hbCreateDecodeTables)
            let is i64 as minLen with mut = 32;
            let is i64 as maxLen with mut = 0;
            si = 0;
            while (si < alphaSize) {
                let is i64 as L = lens[g * 258 + si];
                if (L > maxLen) { maxLen = L; }
                if (L < minLen) { minLen = L; }
                si = si + 1;
            }
            let is i64 as pp with mut = 0;
            let is i64 as L2 with mut = minLen;
            while (L2 <= maxLen) {
                si = 0;
                while (si < alphaSize) {
                    if (lens[g * 258 + si] == L2) { perm[g * 258 + pp] = si; pp = pp + 1; }
                    si = si + 1;
                }
                L2 = L2 + 1;
            }
            i = 0;
            while (i < 25) { base[g * 25 + i] = 0; i = i + 1; }
            si = 0;
            while (si < alphaSize) {
                let is i64 as idx = lens[g * 258 + si] + 1;
                base[g * 25 + idx] = base[g * 25 + idx] + 1;
                si = si + 1;
            }
            i = 1;
            while (i < 25) { base[g * 25 + i] = base[g * 25 + i] + base[g * 25 + i - 1]; i = i + 1; }
            i = 0;
            while (i < 25) { limit[g * 25 + i] = 0; i = i + 1; }
            let is i64 as vec with mut = 0;
            L2 = minLen;
            while (L2 <= maxLen) {
                vec = vec + (base[g * 25 + L2 + 1] - base[g * 25 + L2]);
                limit[g * 25 + L2] = vec - 1;
                vec = vec << 1;
                L2 = L2 + 1;
            }
            L2 = minLen + 1;
            while (L2 <= maxLen) {
                base[g * 25 + L2] = ((limit[g * 25 + L2 - 1] + 1) << 1) - base[g * 25 + L2];
                L2 = L2 + 1;
            }
            minLens[g] = minLen;
            g = g + 1;
        }

        // MTF + RUNA/RUNB decode -> BWT last column (bwt[]) + unzftab counts
        i = 0;
        while (i < 256) { unzftab[i] = 0; i = i + 1; }
        i = 0;
        while (i < nInUse) { mtf[i] = symMap[i]; i = i + 1; }

        let is i64 as nblock with mut = 0;
        let is i64 as groupNo with mut = 0 - 1;
        let is i64 as groupPos with mut = 0;
        let is i64 as curGroup with mut = 0;
        let is i64 as runLen with mut = 0;
        let is i64 as runBit with mut = 0;

        while (1 == 1) {
            if (groupPos == 0) {
                groupNo = groupNo + 1;
                groupPos = 50;
                curGroup = selectors[groupNo];
            }
            groupPos = groupPos - 1;

            // decode one symbol with curGroup's table
            let is i64 as zn with mut = minLens[curGroup];
            let is i64 as zvec with mut = _bits(&b, zn);
            while (zvec > limit[curGroup * 25 + zn]) {
                zn = zn + 1;
                zvec = (zvec << 1) | _bit(&b);
            }
            let is i64 as sym = perm[curGroup * 258 + (zvec - base[curGroup * 25 + zn])];

            if (sym <= 1) {
                // RUNA (0) / RUNB (1): accumulate bijective run length
                if (sym == 0) { runLen = runLen + (1 << runBit); }
                else { runLen = runLen + (2 << runBit); }
                runBit = runBit + 1;
            } else {
                // flush a pending run of the front MTF byte
                if (runLen > 0) {
                    let is i64 as fb = mtf[0];
                    unzftab[fb] = unzftab[fb] + runLen;
                    let is i64 as r with mut = 0;
                    while (r < runLen) {
                        if (nblock >= maxBlock) { return errno.Z_BADLEN; }
                        bwt[nblock] = fb;
                        nblock = nblock + 1;
                        r = r + 1;
                    }
                    runLen = 0;
                    runBit = 0;
                }
                if (sym == EOB) { break; }
                // MTF index = sym - 1
                let is i64 as jx = sym - 1;
                let is i64 as bb = mtf[jx];
                let is i64 as k with mut = jx;
                while (k > 0) { mtf[k] = mtf[k - 1]; k = k - 1; }
                mtf[0] = bb;
                unzftab[bb] = unzftab[bb] + 1;
                if (nblock >= maxBlock) { return errno.Z_BADLEN; }
                bwt[nblock] = bb;
                nblock = nblock + 1;
            }
        }

        // inverse BWT: build the T (next) vector via cumulative counts
        cftab[0] = 0;
        i = 1;
        while (i <= 256) { cftab[i] = unzftab[i - 1]; i = i + 1; }
        i = 1;
        while (i <= 256) { cftab[i] = cftab[i] + cftab[i - 1]; i = i + 1; }
        i = 0;
        while (i < nblock) {
            let is i64 as c = bwt[i];
            tt[cftab[c]] = i;
            cftab[c] = cftab[c] + 1;
            i = i + 1;
        }

        // follow the chain from origPtr, RLE1-decoding the byte stream
        let is i64 as tPos with mut = tt[origPtr];
        let is i64 as prev with mut = 0 - 1;
        let is i64 as rl with mut = 0;
        let is i64 as rNToGo with mut = 0;
        let is i64 as rTPos with mut = 0;
        i = 0;
        while (i < nblock) {
            let is i64 as by with mut = bwt[tPos];
            tPos = tt[tPos];
            i = i + 1;
            if (randomized == 1) {
                if (rNToGo == 0) { rNToGo = _rnum(rTPos); rTPos = rTPos + 1; if (rTPos == 512) { rTPos = 0; } }
                rNToGo = rNToGo - 1;
                if (rNToGo == 1) { by = by ^ 1; }
            }
            if (rl == 4) {
                // `by` is the count of additional repeats of `prev`
                let is i64 as r with mut = 0;
                while (r < by) {
                    if (bytes.bytes_push(out, cast(u8, prev)) < 0) { return errno.Z_OOM; }
                    r = r + 1;
                }
                rl = 0;
                prev = 0 - 1;
            } else {
                if (bytes.bytes_push(out, cast(u8, by)) < 0) { return errno.Z_OOM; }
                if (by == prev) { rl = rl + 1; }
                else { prev = by; rl = 1; }
            }
        }
        // verify this block's CRC over its decoded output, fold into combined
        let is i64 as gotBlockCrc = _bzcrc32(cast(*u8, cast(i64, out.ptr) + blockOutStart), out.len - blockOutStart);
        if (gotBlockCrc != junk1) { return errno.Z_BADSUM; }
        combinedCrc = (((combinedCrc << 1) | ((combinedCrc >> 31) & 1)) & 0xFFFFFFFF) ^ gotBlockCrc;
    }
    return out.len;
}

// ===================== bzip2 ENCODER ===================================
// MSB-first bit writer.
struct BzWr { out as *bytes.Bytes; acc as i64; nbits as i64; }
fn _bw_put(w as *BzWr, value as i64, n as i64) as void {
    w.acc = (w.acc << n) | (value & ((1 << n) - 1));
    w.nbits = w.nbits + n;
    while (w.nbits >= 8) {
        w.nbits = w.nbits - 8;
        bytes.bytes_push(w.out, cast(u8, (w.acc >> w.nbits) & 0xFF));
    }
}
fn _bw_flush(w as *BzWr) as void {
    if (w.nbits > 0) {
        bytes.bytes_push(w.out, cast(u8, (w.acc << (8 - w.nbits)) & 0xFF));
        w.nbits = 0; w.acc = 0;
    }
}

// CRC-32/BZIP2 (non-reflected, poly 0x04C11DB7).
let is *i64 as _bzcrc with mut;
let is i32 as _bzcrc_ready with mut = 0;
fn _bzcrc_init() as void {
    if (_bzcrc_ready == 1) { return; }
    _bzcrc = _i64arr(256);
    let is i64 as n with mut = 0;
    while (n < 256) {
        let is i64 as c with mut = (n << 24) & 0xFFFFFFFF;
        let is i64 as k with mut = 0;
        while (k < 8) {
            if ((c & 0x80000000) != 0) { c = ((c << 1) ^ 0x04C11DB7) & 0xFFFFFFFF; }
            else { c = (c << 1) & 0xFFFFFFFF; }
            k = k + 1;
        }
        _bzcrc[n] = c;
        n = n + 1;
    }
    _bzcrc_ready = 1;
}
fn _bzcrc32(buf as *u8, len as i64) as i64 {
    _bzcrc_init();
    let is i64 as crc with mut = 0xFFFFFFFF;
    let is i64 as i with mut = 0;
    while (i < len) {
        crc = ((crc << 8) ^ _bzcrc[((crc >> 24) ^ cast(i64, buf[i])) & 0xFF]) & 0xFFFFFFFF;
        i = i + 1;
    }
    return crc ^ 0xFFFFFFFF;
}

// Length-limited Huffman code lengths (BZ2_hbMakeCodeLengths), maxLen 17.
fn _mk_lengths(len as *i64, freq as *i64, alphaSize as i64) as void {
    let is *i64 as heap = _i64arr(516);
    let is *i64 as weight = _i64arr(520);
    let is *i64 as parent = _i64arr(520);
    let is i64 as i with mut = 0;
    while (i < alphaSize) {
        let is i64 as f with mut = freq[i];
        if (f == 0) { f = 1; }
        weight[i + 1] = f << 8;
        i = i + 1;
    }
    while (1 == 1) {
        let is i64 as nNodes with mut = alphaSize;
        let is i64 as nHeap with mut = 0;
        heap[0] = 0; weight[0] = 0; parent[0] = 0 - 2;
        i = 1;
        while (i <= alphaSize) {
            parent[i] = 0 - 1; nHeap = nHeap + 1; heap[nHeap] = i;
            let is i64 as zz with mut = nHeap;
            let is i64 as tmp = heap[zz];
            while (weight[tmp] < weight[heap[zz >> 1]]) { heap[zz] = heap[zz >> 1]; zz = zz >> 1; }
            heap[zz] = tmp;
            i = i + 1;
        }
        while (nHeap > 1) {
            let is i64 as n1 = heap[1]; heap[1] = heap[nHeap]; nHeap = nHeap - 1;
            let is i64 as zz1 with mut = 1;
            let is i64 as tmp1 = heap[zz1];
            while (1 == 1) {
                let is i64 as yy with mut = zz1 << 1;
                if (yy > nHeap) { break; }
                if (yy < nHeap) { if (weight[heap[yy + 1]] < weight[heap[yy]]) { yy = yy + 1; } }
                if (weight[tmp1] < weight[heap[yy]]) { break; }
                heap[zz1] = heap[yy]; zz1 = yy;
            }
            heap[zz1] = tmp1;
            let is i64 as n2 = heap[1]; heap[1] = heap[nHeap]; nHeap = nHeap - 1;
            let is i64 as zz2 with mut = 1;
            let is i64 as tmp2 = heap[zz2];
            while (1 == 1) {
                let is i64 as yy with mut = zz2 << 1;
                if (yy > nHeap) { break; }
                if (yy < nHeap) { if (weight[heap[yy + 1]] < weight[heap[yy]]) { yy = yy + 1; } }
                if (weight[tmp2] < weight[heap[yy]]) { break; }
                heap[zz2] = heap[yy]; zz2 = yy;
            }
            heap[zz2] = tmp2;
            nNodes = nNodes + 1;
            parent[n1] = nNodes; parent[n2] = nNodes;
            let is i64 as w1 = weight[n1];
            let is i64 as w2 = weight[n2];
            let is i64 as lo1 = w1 & 0xFF;
            let is i64 as lo2 = w2 & 0xFF;
            let is i64 as mx with mut = lo1;
            if (lo2 > mx) { mx = lo2; }
            weight[nNodes] = ((w1 & 0xFFFFFF00) + (w2 & 0xFFFFFF00)) | (1 + mx);
            parent[nNodes] = 0 - 1; nHeap = nHeap + 1; heap[nHeap] = nNodes;
            let is i64 as zz3 with mut = nHeap;
            let is i64 as tmp3 = heap[zz3];
            while (weight[tmp3] < weight[heap[zz3 >> 1]]) { heap[zz3] = heap[zz3 >> 1]; zz3 = zz3 >> 1; }
            heap[zz3] = tmp3;
        }
        let is i64 as tooLong with mut = 0;
        i = 1;
        while (i <= alphaSize) {
            let is i64 as j with mut = 0;
            let is i64 as k with mut = i;
            while (parent[k] >= 0) { k = parent[k]; j = j + 1; }
            len[i - 1] = j;
            if (j > 17) { tooLong = 1; }
            i = i + 1;
        }
        if (tooLong == 0) { break; }
        i = 1;
        while (i <= alphaSize) {
            let is i64 as j with mut = weight[i] >> 8;
            j = 1 + (j / 2);
            weight[i] = j << 8;
            i = i + 1;
        }
    }
    mem.core.munmap(cast(*u8, heap), 516 * 8);
    mem.core.munmap(cast(*u8, weight), 520 * 8);
    mem.core.munmap(cast(*u8, parent), 520 * 8);
}

// Sift-down for heapsort of sa[lo..lo+cnt) by second key rank[(sa[k]+kk)%n].
fn _hsdown(sa as *i64, lo as i64, start as i64, cnt as i64, rank as *i64, kk as i64, n as i64) as void {
    let is i64 as root with mut = start;
    while (root * 2 + 1 < cnt) {
        let is i64 as child with mut = root * 2 + 1;
        let is i64 as tc with mut = sa[lo + child] + kk; if (tc >= n) { tc = tc - n; }
        let is i64 as kc with mut = rank[tc];
        if (child + 1 < cnt) {
            let is i64 as t2 with mut = sa[lo + child + 1] + kk; if (t2 >= n) { t2 = t2 - n; }
            if (rank[t2] > kc) { child = child + 1; kc = rank[t2]; }
        }
        let is i64 as tr with mut = sa[lo + root] + kk; if (tr >= n) { tr = tr - n; }
        if (rank[tr] < kc) {
            let is i64 as tmp = sa[lo + root]; sa[lo + root] = sa[lo + child]; sa[lo + child] = tmp;
            root = child;
        } else { return; }
    }
}
// In-place heapsort of sa[lo..hi) by second key (ascending); ties are fine.
fn _hsort2(sa as *i64, lo as i64, hi as i64, rank as *i64, kk as i64, n as i64) as void {
    let is i64 as cnt = hi - lo;
    let is i64 as i with mut = cnt / 2 - 1;
    while (i >= 0) { _hsdown(sa, lo, i, cnt, rank, kk, n); i = i - 1; }
    i = cnt - 1;
    while (i > 0) {
        let is i64 as tmp = sa[lo]; sa[lo] = sa[lo + i]; sa[lo + i] = tmp;
        _hsdown(sa, lo, 0, i, rank, kk, n);
        i = i - 1;
    }
}

// stable counting sort of sa[] (length n) by key[sa[i]] in [0, mk]; into dst.
fn _csort(sa as *i64, dst as *i64, key as *i64, n as i64, cnt as *i64, mk as i64) as void {
    let is i64 as i with mut = 0;
    while (i <= mk + 1) { cnt[i] = 0; i = i + 1; }
    i = 0;
    while (i < n) { cnt[key[sa[i]] + 1] = cnt[key[sa[i]] + 1] + 1; i = i + 1; }
    i = 1;
    while (i <= mk) { cnt[i] = cnt[i] + cnt[i - 1]; i = i + 1; }
    i = 0;
    while (i < n) {
        let is i64 as k = key[sa[i]];
        dst[cnt[k]] = sa[i];
        cnt[k] = cnt[k] + 1;
        i = i + 1;
    }
}

// Encode one bzip2 block (<= ~900 KB of input) into the shared bit writer w.
fn _emit_bzip2_block(src as *u8, src_len as i64, w as *BzWr) as i64 {
    if (src_len <= 0) { return 0; }

    // --- RLE1 ---
    let is *u8 as rle = mem.core.mmap_anon(src_len * 2 + 16);
    let is i64 as rn with mut = 0;
    let is i64 as i with mut = 0;
    while (i < src_len) {
        let is i64 as b = cast(i64, src[i]);
        let is i64 as run with mut = 1;
        i = i + 1;
        while (i < src_len) { if (cast(i64, src[i]) != b) { break; } run = run + 1; i = i + 1; }
        while (run >= 4) {
            let is i64 as c with mut = run - 4;
            if (c > 251) { c = 251; }
            rle[rn] = cast(u8, b); rle[rn + 1] = cast(u8, b); rle[rn + 2] = cast(u8, b); rle[rn + 3] = cast(u8, b);
            rle[rn + 4] = cast(u8, c); rn = rn + 5;
            run = run - (4 + c);
        }
        while (run > 0) { rle[rn] = cast(u8, b); rn = rn + 1; run = run - 1; }
    }

    // --- forward BWT (prefix-doubling rotation sort) ---
    let is i64 as n = rn;
    let is *i64 as sa = _i64arr(n + 1);
    let is *i64 as sa2 = _i64arr(n + 1);
    let is *i64 as rank = _i64arr(n + 1);
    let is *i64 as nrank = _i64arr(n + 1);
    let is *i64 as key = _i64arr(n + 1);
    let is *i64 as cnt = _i64arr(n + 260);
    let is i64 as maxRank with mut = 255;
    i = 0;
    while (i < n) { sa[i] = i; rank[i] = cast(i64, rle[i]); i = i + 1; }
    let is i64 as kk with mut = 1;
    while (kk < n) {
        if (kk == 1 || maxRank * 2 < n) {
            // counting sort while groups are still large (protects repetitive data)
            i = 0;
            while (i < n) { let is i64 as idx with mut = i + kk; if (idx >= n) { idx = idx - n; } key[i] = rank[idx]; i = i + 1; }
            _csort(sa, sa2, key, n, cnt, maxRank);
            _csort(sa2, sa, rank, n, cnt, maxRank);
        } else {
            // singletons dominate: only re-sort non-singleton groups (Manber-Myers skip)
            i = 0;
            while (i < n) {
                let is i64 as j with mut = i + 1;
                while (j < n) { if (rank[sa[j]] != rank[sa[i]]) { break; } j = j + 1; }
                if (j - i > 1) { _hsort2(sa, i, j, rank, kk, n); }
                i = j;
            }
        }
        // recompute ranks
        nrank[sa[0]] = 0;
        let is i64 as r with mut = 0;
        i = 1;
        while (i < n) {
            let is i64 as a = sa[i - 1];
            let is i64 as bb = sa[i];
            let is i64 as a2 with mut = a + kk; if (a2 >= n) { a2 = a2 - n; }
            let is i64 as b2 with mut = bb + kk; if (b2 >= n) { b2 = b2 - n; }
            if (rank[a] != rank[bb]) { r = r + 1; }
            else { if (rank[a2] != rank[b2]) { r = r + 1; } }
            nrank[bb] = r;
            i = i + 1;
        }
        i = 0;
        while (i < n) { rank[i] = nrank[i]; i = i + 1; }
        maxRank = r;
        if (r == n - 1) { break; }
        kk = kk * 2;
    }
    // BWT last column + origPtr
    let is *u8 as bwt = mem.core.mmap_anon(n + 8);
    let is i64 as origPtr with mut = 0;
    i = 0;
    while (i < n) {
        let is i64 as p = sa[i];
        if (p == 0) { origPtr = i; bwt[i] = rle[n - 1]; }
        else { bwt[i] = rle[p - 1]; }
        i = i + 1;
    }

    // --- MTF + RLE2 ---
    let is [256]i64 as inUse;
    i = 0; while (i < 256) { inUse[i] = 0; i = i + 1; }
    i = 0; while (i < n) { inUse[cast(i64, bwt[i])] = 1; i = i + 1; }
    let is [256]i64 as symMap;
    let is i64 as nInUse with mut = 0;
    i = 0;
    while (i < 256) { if (inUse[i] == 1) { symMap[nInUse] = i; nInUse = nInUse + 1; } i = i + 1; }
    let is i64 as EOB = nInUse + 1;
    let is i64 as alphaSize = nInUse + 2;

    let is [256]i64 as mtf;
    i = 0; while (i < nInUse) { mtf[i] = symMap[i]; i = i + 1; }
    let is *i64 as syms = _i64arr(n + 16);
    let is i64 as ns with mut = 0;
    let is *i64 as freq = _i64arr(alphaSize + 2);
    i = 0; while (i < alphaSize) { freq[i] = 0; i = i + 1; }
    let is i64 as zr with mut = 0;
    i = 0;
    while (i < n) {
        let is i64 as bb = cast(i64, bwt[i]);
        let is i64 as j with mut = 0;
        while (mtf[j] != bb) { j = j + 1; }
        if (j == 0) {
            zr = zr + 1;
        } else {
            while (zr > 0) {
                zr = zr - 1;
                let is i64 as sym = zr & 1;       // RUNA=0 / RUNB=1
                syms[ns] = sym; freq[sym] = freq[sym] + 1; ns = ns + 1;
                zr = zr >> 1;
            }
            let is i64 as v = mtf[j];
            let is i64 as kk2 with mut = j;
            while (kk2 > 0) { mtf[kk2] = mtf[kk2 - 1]; kk2 = kk2 - 1; }
            mtf[0] = v;
            syms[ns] = j + 1; freq[j + 1] = freq[j + 1] + 1; ns = ns + 1;
        }
        i = i + 1;
    }
    while (zr > 0) {
        zr = zr - 1;
        let is i64 as sym = zr & 1;
        syms[ns] = sym; freq[sym] = freq[sym] + 1; ns = ns + 1;
        zr = zr >> 1;
    }
    syms[ns] = EOB; freq[EOB] = freq[EOB] + 1; ns = ns + 1;

    // --- Huffman code lengths (2 identical groups) ---
    let is *i64 as len = _i64arr(alphaSize + 2);
    _mk_lengths(len, freq, alphaSize);
    let is i64 as minLen with mut = 32;
    let is i64 as maxLen with mut = 0;
    i = 0;
    while (i < alphaSize) { if (len[i] > maxLen) { maxLen = len[i]; } if (len[i] < minLen) { minLen = len[i]; } i = i + 1; }
    let is *i64 as code = _i64arr(alphaSize + 2);
    let is i64 as vec with mut = 0;
    let is i64 as L with mut = minLen;
    while (L <= maxLen) {
        i = 0;
        while (i < alphaSize) { if (len[i] == L) { code[i] = vec; vec = vec + 1; } i = i + 1; }
        vec = vec << 1;
        L = L + 1;
    }

    // --- block header ---
    let is i64 as crc = _bzcrc32(src, src_len);
    _bw_put(w, 0x314159, 24); _bw_put(w, 0x265359, 24);   // block magic
    _bw_put(w, (crc >> 16) & 0xFFFF, 16); _bw_put(w, crc & 0xFFFF, 16);
    _bw_put(w, 0, 1);                                       // not randomized
    _bw_put(w, origPtr, 24);

    // symbol map (16-bit group mask + per-group 16-bit)
    let is i64 as used16 with mut = 0;
    let is i64 as g with mut = 0;
    while (g < 16) {
        let is i64 as any with mut = 0;
        let is i64 as s with mut = 0;
        while (s < 16) { if (inUse[g * 16 + s] == 1) { any = 1; } s = s + 1; }
        if (any == 1) { used16 = used16 | (1 << (15 - g)); }
        g = g + 1;
    }
    _bw_put(w, used16, 16);
    g = 0;
    while (g < 16) {
        if (((used16 >> (15 - g)) & 1) == 1) {
            let is i64 as bits with mut = 0;
            let is i64 as s with mut = 0;
            while (s < 16) { if (inUse[g * 16 + s] == 1) { bits = bits | (1 << (15 - s)); } s = s + 1; }
            _bw_put(w, bits, 16);
        }
        g = g + 1;
    }

    // 2 groups, all selectors = 0
    _bw_put(w, 2, 3);
    let is i64 as nSel = (ns + 49) / 50;
    _bw_put(w, nSel, 15);
    let is i64 as si with mut = 0;
    while (si < nSel) { _bw_put(w, 0, 1); si = si + 1; }   // selector MTF index 0 -> "0"

    // 2 identical Huffman tables (delta-encoded lengths)
    let is i64 as gi with mut = 0;
    while (gi < 2) {
        let is i64 as curr with mut = len[0];
        _bw_put(w, curr, 5);
        i = 0;
        while (i < alphaSize) {
            while (curr != len[i]) {
                _bw_put(w, 1, 1);
                if (curr < len[i]) { _bw_put(w, 0, 1); curr = curr + 1; }
                else { _bw_put(w, 1, 1); curr = curr - 1; }
            }
            _bw_put(w, 0, 1);
            i = i + 1;
        }
        gi = gi + 1;
    }

    // data: encode all MTF/RLE2 symbols with group 0
    i = 0;
    while (i < ns) { _bw_put(w, code[syms[i]], len[syms[i]]); i = i + 1; }
    
    return 0;
}

fn bzip2_compress(src as *u8, src_len as i64, out as *bytes.Bytes, level as i64) as i64 {
    bytes.bytes_push(out, cast(u8, 0x42)); bytes.bytes_push(out, cast(u8, 0x5A));
    bytes.bytes_push(out, cast(u8, 0x68)); bytes.bytes_push(out, cast(u8, 0x39));   // "BZh9"

    let is BzWr as w;
    w.out = out; w.acc = 0; w.nbits = 0;

    let is i64 as maxBlk with imut = 900000;
    let is i64 as combined with mut = 0;
    if (src_len > 0) {
        let is i64 as pos with mut = 0;
        while (pos < src_len) {
            let is i64 as chunk with mut = src_len - pos;
            if (chunk > maxBlk) { chunk = maxBlk; }
            _emit_bzip2_block(cast(*u8, cast(i64, src) + pos), chunk, &w);
            // fold this block's CRC into the stream-combined CRC
            let is i64 as blockCrc = _bzcrc32(cast(*u8, cast(i64, src) + pos), chunk);
            combined = (((combined << 1) | ((combined >> 31) & 1)) & 0xFFFFFFFF) ^ blockCrc;
            pos = pos + chunk;
        }
    }
    _bw_put(&w, 0x177245, 24); _bw_put(&w, 0x385090, 24);   // eos magic
    _bw_put(&w, (combined >> 16) & 0xFFFF, 16); _bw_put(&w, combined & 0xFFFF, 16);
    _bw_flush(&w);
    return out.len;
}
