    let is i64 as b with mut = 0;
    b = b + check(7, "hello",  "tests/fixtures/hello.bz2",  "tests/fixtures/hello.bin");
    b = b + check(7, "lorem",  "tests/fixtures/lorem.bz2",  "tests/fixtures/lorem.bin");
