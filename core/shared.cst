// What lets decoders run in several threads at once: tables made by one thread while the others
// wait, and memory of one call, let go of whole when it ends. No syscalls but mmap's.
use "std/mem.cst" only core as mem;

// 0 not made, 1 being made, 2 made. once_enter says 1 to the one who is to make it, who then says
// once_leave, with 0 when it could not and the next to ask is to try.
fn once_enter(o as *u32) as i64 {
    while (1 == 1) {
        if (atomic_load(o) == 2) { return 0; }
        if (atomic_cas(o, 0, 1) == 0) { return 1; }
        while (atomic_load(o) == 1) { }
    }
    return 0;
}
fn once_leave(o as *u32, made as i64) as void {
    if (made == 1) { atomic_store(o, 2); } else { atomic_store(o, 0); }
}

struct Scratch { chunk as *i64; at as i64; end as i64; }
let is i64 as CHUNK with imut = 131072;
fn scratch_new() as Scratch {
    let is Scratch as s with mut;
    s.chunk = cast(*i64, 0);
    s.at = 0;
    s.end = 0;
    return s;
}
// n words, all zero.
fn scratch_words(s as *Scratch, n as i64) as *i64 {
    let is i64 as need = n * 8;
    if (s.at + need > s.end) {
        let is i64 as size with mut = CHUNK;
        if (need + 16 > size) { size = (need + 16 + 4095) & (0 - 4096); }
        let is *i64 as c = cast(*i64, mem.core.mmap_anon(size));
        c[0] = cast(i64, s.chunk);
        c[1] = size;
        s.chunk = c;
        s.at = cast(i64, c) + 16;
        s.end = cast(i64, c) + size;
    }
    let is i64 as p = s.at;
    s.at = s.at + need;
    return cast(*i64, p);
}
fn scratch_free(s as *Scratch) as void {
    let is *i64 as c with mut = s.chunk;
    while (cast(i64, c) != 0) {
        let is *i64 as up = cast(*i64, c[0]);
        mem.core.munmap(cast(*u8, c), c[1]);
        c = up;
    }
    s.chunk = cast(*i64, 0);
    s.at = 0;
    s.end = 0;
}
