// =======================================================
// caustic-compact/core/bytes.cst
// Bytes — growable, owned heap buffer. Every decoder accumulates its
// output here; every encoder builds its compressed stream here.
// Backed directly by mmap (page allocator) so it can grow without bound —
// the bins slab allocator caps single allocations at its page size, which
// is fine for small fixed structures but not for (de)compressed output.
// =======================================================

use "std/mem.cst" only bins, core as mem;

struct Bytes {
    ptr as *u8;
    len as i64;
    cap as i64;      // exact mmap length backing ptr
    max_len as i64;  // -1 = unlimited; otherwise bytes_reserve cannot exceed it
}

// New buffer with capacity `cap` (>=1). len starts at 0.
fn bytes_new(cap as i64) as Bytes {
    let is i64 as c with mut = cap;
    if (c < 1) { c = 16; }
    let is Bytes as b;
    b.ptr = mem.core.mmap_anon(c);
    b.len = 0;
    b.cap = c;
    b.max_len = 0 - 1;
    return b;
}

// Ensure room for at least `extra` more bytes; grows (doubling) if needed.
// Returns 0 ok, <0 on alloc failure. May remap — recompute raw pointers after.
fn bytes_reserve(b as *Bytes, extra as i64) as i64 {
    let is i64 as need = b.len + extra;
    if (b.max_len >= 0 && need > b.max_len) { return 0 - 1; }
    if (need <= b.cap) { return 0; }
    let is i64 as ncap with mut = b.cap;
    if (ncap < 1) { ncap = 1; }
    while (ncap < need) { ncap = ncap * 2; }
    let is *u8 as np = mem.core.mmap_anon(ncap);
    if (cast(i64, np) <= 0) { return 0 - 1; }
    if (b.len > 0) { mem.core.memcpy(np, b.ptr, b.len); }
    if (cast(i64, b.ptr) > 0) { mem.core.munmap(b.ptr, b.cap); }
    b.ptr = np;
    b.cap = ncap;
    return 0;
}

// Append `n` bytes from `src`. Returns 0 ok, <0 on alloc failure.
fn bytes_append(b as *Bytes, src as *u8, n as i64) as i64 {
    if (n <= 0) { return 0; }
    if (bytes_reserve(b, n) < 0) { return 0 - 1; }
    mem.core.memcpy(cast(*u8, cast(i64, b.ptr) + b.len), src, n);
    b.len = b.len + n;
    return 0;
}

// Append a single byte. Returns 0 ok, <0 on alloc failure.
fn bytes_push(b as *Bytes, byte as u8) as i64 {
    if (bytes_reserve(b, 1) < 0) { return 0 - 1; }
    b.ptr[b.len] = byte;
    b.len = b.len + 1;
    return 0;
}

fn bytes_reset(b as *Bytes) as void {
    b.len = 0;
}

fn bytes_free(b as *Bytes) as void {
    if (cast(i64, b.ptr) > 0) { mem.core.munmap(b.ptr, b.cap); }
    b.ptr = cast(*u8, 0);
    b.len = 0;
    b.cap = 0;
    b.max_len = 0 - 1;
}
