// =======================================================
// caustic-compact/core/huffman.cst
// Canonical Huffman decoding for DEFLATE (RFC 1951 §3.2.2). huff_build makes
// a 9-bit root lookup table (reversed canonical codes): codes up to 9 bits
// decode in one lookup; the rare longer codes fall back to a bit-at-a-time
// canonical walk. The root table is small (512 entries) so building it per
// block is cheap.
// =======================================================

use "errno.cst" as errno;
use "bitreader.cst" as bitreader;
use "std/mem.cst" only bins, core as mem;
let is i64 as ROOT with imut = 9;

let is mem.Bins as _bins with mut;
let is i32 as _ready with mut = 0;
let is i32 as _custom with mut = 0;
let is i64 as _alloc_fn with mut = 0;
let is i64 as _free_fn with mut = 0;

// A freestanding caller supplies allocation that does not depend on an OS
// syscall. Install before the first Huffman table is built; the default remains
// the process allocator used by the standalone codecs.
fn huff_set_allocator(alloc as i64, free as i64) as i32 {
    if (alloc == 0 || free == 0 || _ready != 0 || _custom != 0) {
        return cast(i32, 0 - 1);
    }
    _alloc_fn = alloc;
    _free_fn = free;
    _custom = 1;
    return cast(i32, 0);
}

fn _h_alloc(size as i64) as *u8 {
    if (_custom == 1) {
        let is fn(i64) as *u8 as fp = cast(fn(i64) as *u8, _alloc_fn);
        return call(fp, size);
    }
    if (_ready == 0) { _bins = mem.bins.bins_new(65536); _ready = 1; }
    return mem.bins.bins_alloc(&_bins, size);
}

fn _h_free(ptr as *u8) as void {
    if (_custom == 1) {
        let is fn(*u8) as void as fp = cast(fn(*u8) as void, _free_fn);
        call(fp, ptr);
        return;
    }
    if (_ready == 1) { mem.bins.bins_free(&_bins, ptr); }
}

// count[len]  : number of symbols having each code length (len 0..15)
// symbol[]    : symbols sorted by (length, symbol) — canonical order
// fast[]      : 1<<ROOT entries, (length << 16) | symbol; 0 = escape to slow walk
struct Huff {
    count   as *i64;   // 16 entries
    symbol  as *i64;   // n entries
    n       as i64;    // alphabet size
    fast    as *i64;   // 1<<ROOT lookup table
    maxbits as i64;    // longest code length present
}

fn _h_release(h as *Huff) as void {
    if (cast(i64, h.count) != 0) { _h_free(cast(*u8, h.count)); }
    if (cast(i64, h.symbol) != 0) { _h_free(cast(*u8, h.symbol)); }
    if (cast(i64, h.fast) != 0) { _h_free(cast(*u8, h.fast)); }
    h.count = cast(*i64, 0);
    h.symbol = cast(*i64, 0);
    h.fast = cast(*i64, 0);
    h.n = 0;
    h.maxbits = 0;
}

// Reverse the low `len` bits of `code` (the stream reads codes MSB-first).
fn _rev(code as i64, len as i64) as i64 {
    let is i64 as r with mut = 0;
    let is i64 as i with mut = 0;
    while (i < len) { r = (r << 1) | ((code >> i) & 1); i = i + 1; }
    return r;
}

// Build a canonical Huffman table from `lengths`. Returns 0, Z_OOM, or
// Z_BADHUFF (over-subscribed). Incomplete codes are tolerated.
fn huff_build(h as *Huff, lengths as *i64, n as i64) as i64 {
    h.n = n;
    h.count  = cast(*i64, _h_alloc(16 * 8));
    h.symbol = cast(*i64, _h_alloc(n * 8));
    h.fast   = cast(*i64, _h_alloc((1 << ROOT) * 8));
    if (cast(i64, h.count) == 0 || cast(i64, h.symbol) == 0 || cast(i64, h.fast) == 0) {
        _h_release(h);
        return errno.Z_OOM;
    }

    let is i64 as i with mut = 0;
    while (i < 16) { h.count[i] = 0; i = i + 1; }
    i = 0;
    while (i < n) { let is i64 as L = lengths[i]; h.count[L] = h.count[L] + 1; i = i + 1; }
    h.count[0] = 0;

    let is i64 as left with mut = 1;
    let is i64 as cl with mut = 1;
    let is i64 as mb with mut = 0;
    while (cl < 16) {
        left = (left << 1) - h.count[cl];
        if (left < 0) { _h_release(h); return errno.Z_BADHUFF; }
        if (h.count[cl] > 0) { mb = cl; }
        cl = cl + 1;
    }
    h.maxbits = mb;

    let is [16]i64 as offs;
    offs[1] = 0;
    let is i64 as L2 with mut = 1;
    while (L2 < 15) { offs[L2 + 1] = offs[L2] + h.count[L2]; L2 = L2 + 1; }
    i = 0;
    while (i < n) {
        let is i64 as li = lengths[i];
        if (li != 0) { h.symbol[offs[li]] = i; offs[li] = offs[li] + 1; }
        i = i + 1;
    }

    // 9-bit root table: direct entries for codes <= ROOT, 0 (escape) otherwise
    let is i64 as tsize = 1 << ROOT;
    i = 0;
    while (i < tsize) { h.fast[i] = 0; i = i + 1; }
    let is i64 as code with mut = 0;
    let is i64 as idx with mut = 0;
    let is i64 as L3 with mut = 1;
    while (L3 <= mb) {
        let is i64 as c with mut = 0;
        while (c < h.count[L3]) {
            if (L3 <= ROOT) {
                let is i64 as entry = (L3 << 16) | h.symbol[idx];
                let is i64 as k with mut = _rev(code, L3);
                let is i64 as step = 1 << L3;
                while (k < tsize) { h.fast[k] = entry; k = k + step; }
            }
            code = code + 1;
            idx = idx + 1;
            c = c + 1;
        }
        code = code << 1;
        L3 = L3 + 1;
    }
    return 0;
}

fn huff_free(h as *Huff) as void {
    _h_release(h);
}

// Bit-at-a-time canonical walk (fallback for codes longer than ROOT).
fn _huff_slow(h as *Huff, br as *bitreader.BitReader) as i64 {
    let is i64 as code  with mut = 0;
    let is i64 as first with mut = 0;
    let is i64 as index with mut = 0;
    let is i64 as L with mut = 1;
    while (L < 16) {
        let is i64 as bit = bitreader.br_get(br, 1);
        if (bit < 0) { return errno.Z_EOF; }
        code = code | bit;
        let is i64 as cnt = h.count[L];
        if (code - first < cnt) { return h.symbol[index + (code - first)]; }
        index = index + cnt;
        first = (first + cnt) << 1;
        code = code << 1;
        L = L + 1;
    }
    return errno.Z_BADHUFF;
}

// Decode one symbol: single lookup for codes up to ROOT bits, else slow walk.
fn huff_decode(h as *Huff, br as *bitreader.BitReader) as i64 {
    while (br.nbits < ROOT) {
        if (br.pos >= br.len) { break; }
        br.acc = br.acc | (cast(i64, br.src[br.pos]) << br.nbits);
        br.pos = br.pos + 1;
        br.nbits = br.nbits + 8;
    }
    let is i64 as entry = h.fast[br.acc & ((1 << ROOT) - 1)];
    let is i64 as length = entry >> 16;
    if (length > 0) {
        br.acc = br.acc >> length;
        br.nbits = br.nbits - length;
        return entry & 0xFFFF;
    }
    return _huff_slow(h, br);
}
