use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" only bins, core as mem;
use "./core/bytes.cst" as bytes;
use "./formats/brotli.cst" as brotli;
fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is *u8 as path = env.argv(1);
    let is i64 as sz = io.file_size(path);
    let is *u8 as buf = mem.core.mmap_anon(sz + 8);
    let is i64 as fd = io._open_read(path); let is i64 as g with mut = 0;
    if (sz > 0) { g = io.read_exact(fd, buf, sz); } io._close_fd(fd);
    let is bytes.Bytes as comp = bytes.bytes_new(256);
    brotli.brotli_compress(buf, sz, &comp, 1);
    io.write_bytes(io.STDOUT, comp.ptr, comp.len);
    return 0;
}
