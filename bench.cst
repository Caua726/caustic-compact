use "std/io.cst" as io;
use "std/env.cst" as env;
use "std/mem.cst" only bins, core as mem;
use "./core/bytes.cst" as bytes;
use "./formats/gzip.cst" as gzip;
use "./formats/lz4.cst" as lz4;
use "./formats/snappy.cst" as snappy;
use "./formats/lzma.cst" as lzma;
use "./formats/xz.cst" as xz;
use "./formats/bzip2.cst" as bzip2;
use "./formats/zstd.cst" as zstd;
use "./formats/brotli.cst" as brotli;
fn main(argc as i64, argv as *u8) as i32 {
    env.init(argc, argv);
    let is *u8 as ks = env.argv(1);
    let is *u8 as path = env.argv(2);
    let is i64 as sz = io.file_size(path);
    let is *u8 as buf = mem.core.mmap_anon(sz + 8);
    let is i64 as fd = io._open_read(path); let is i64 as g with mut = 0;
    if (sz > 0) { g = io.read_exact(fd, buf, sz); } io._close_fd(fd);
    let is bytes.Bytes as out = bytes.bytes_new(256);
    let is i64 as k = cast(i64, ks[0]);
    if (k == 103) { gzip.gzip_compress(buf, sz, &out, 2); }       // 'g' gzip dynamic
    else if (k == 108) { lz4.lz4_compress(buf, sz, &out, 1); }    // 'l' lz4
    else if (k == 115) { snappy.snappy_compress(buf, sz, &out, 1); } // 's' snappy
    else if (k == 109) { lzma.lzma_alone_compress(buf, sz, &out, 1); } // 'm' lzma
    else if (k == 120) { xz.xz_compress(buf, sz, &out, 1); }      // 'x' xz
    else if (k == 98) { bzip2.bzip2_compress(buf, sz, &out, 1); } // 'b' bzip2
    else if (k == 122) { zstd.zstd_compress(buf, sz, &out, 1); }  // 'z' zstd
    else if (k == 114) { brotli.brotli_compress(buf, sz, &out, 1); } // 'r' brotli
    io.write_bytes(io.STDOUT, out.ptr, out.len);
    return 0;
}
